[Unit]
Description=BUST FastAPI Agent Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bust/backend
EnvironmentFile=/home/ubuntu/bust/backend/.env
ExecStart=/home/ubuntu/bust/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
