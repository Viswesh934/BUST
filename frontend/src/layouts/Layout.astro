---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	fullHeight?: boolean;
}

const {
	title = 'BUST — Plan',
	description = 'AI Deal Planning & Execution Workspace',
	fullHeight = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="caramellatte" class={fullHeight ? "h-full overflow-hidden" : ""}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class={fullHeight ? "h-screen max-h-screen overflow-hidden bg-base-100 text-base-content antialiased flex flex-col" : "min-h-screen bg-base-100 text-base-content antialiased flex flex-col"}>
		<!-- Clean Minimalist Header -->
		<header class="h-14 border-b border-base-300 px-4 sm:px-8 flex items-center justify-between bg-base-100 sticky top-0 z-50 shrink-0">
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2 text-decoration-none">
					<span class="text-lg font-black tracking-tight text-base-content">BUST</span>
				</a>
				<span class="text-base-content/30">•</span>
				<span class="text-xs font-bold uppercase tracking-wider text-base-content/80">Plan</span>
			</div>

			<div class="flex items-center gap-3">
				<div class="flex items-center gap-1.5 text-xs">
					<span class="w-2 h-2 rounded-full bg-success"></span>
					<span class="font-medium text-base-content/75">Ready</span>
				</div>
			</div>
		</header>

		<!-- Full-Width Workspace -->
		<main class={fullHeight ? "flex-1 flex flex-col w-full max-w-[1700px] mx-auto px-3 sm:px-6 pt-2 pb-2 min-h-0 overflow-hidden" : "flex-1 flex flex-col w-full max-w-[1700px] mx-auto px-3 sm:px-6 py-3 sm:py-4"}>
			<slot />
		</main>
	</body>
</html>
