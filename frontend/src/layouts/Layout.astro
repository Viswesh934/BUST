---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'BUST — Sales Planning Workspace', description = 'AI Sales Planning & Deal Execution Workspace' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
	{
		label: 'Overview',
		href: '/',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>`,
	},
	{
		label: 'Objection Battlecards',
		href: '/battlecards',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>`,
	},
	{
		label: 'Mutual Action Plans',
		href: '/flowcharts',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>`,
	},
	{
		label: 'Deal Follow-Up Emails',
		href: '/emails',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	},
	{
		label: 'Pitch & ROI Decks',
		href: '/presentations',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>`,
	},
	{
		label: 'Deal Workflow Pipeline',
		href: '/agent',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3"/><path d="M12 19v3"/><path d="m4.93 4.93 2.12 2.12"/><path d="m16.95 16.95 2.12 2.12"/><path d="M2 12h3"/><path d="M19 12h3"/><path d="m4.93 19.07 2.12-2.12"/><path d="m16.95 7.05 2.12-2.12"/></svg>`,
	},
	{
		label: 'Buyer Deal Rooms',
		href: '/deals',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>`,
	},
	{
		label: 'Product Showcase',
		href: '/landing',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
	},
];
---

<!doctype html>
<html lang="en" data-theme="caramellatte">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="min-h-screen bg-base-100 text-base-content antialiased flex flex-col md:flex-row">
		<!-- Sidebar Navigation -->
		<aside class="w-full md:w-64 bg-base-200 border-r border-base-300 flex flex-col shrink-0">
			<!-- Workspace Branding Header -->
			<div class="p-5 border-b border-base-300/80">
				<div class="flex items-center justify-between">
					<a href="/" class="flex items-center gap-2 text-decoration-none">
						<span class="text-xl font-bold tracking-tight text-base-content">BUST</span>
					</a>
					<span class="inline-flex items-center gap-1.5 text-xs text-base-content/70">
						<span class="w-2 h-2 rounded-full bg-success"></span>
						Live
					</span>
				</div>
				<p class="text-xs text-base-content/60 mt-1">Enterprise Sales Workspace</p>
			</div>

			<!-- Navigation Links -->
			<nav class="flex-1 p-3 space-y-1">
				{navItems.map((item) => {
					const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
					return (
						<a
							href={item.href}
							class={`flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
								isActive
									? 'bg-base-300 text-base-content font-semibold shadow-2xs'
									: 'text-base-content/75 hover:bg-base-300/60 hover:text-base-content'
							}`}
						>
							<div class="flex items-center gap-2.5">
								<span class="text-base-content/70" set:html={item.icon} />
								<span>{item.label}</span>
							</div>
						</a>
					);
				})}
			</nav>

			<!-- Account / Team Workspace Card -->
			<div class="p-4 border-t border-base-300/80 bg-base-200/50">
				<div class="flex items-center gap-3">
					<div class="w-8 h-8 rounded-full bg-base-300 flex items-center justify-center font-bold text-xs text-base-content">
						AE
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-xs font-semibold text-base-content truncate">Strategic Accounts Team</div>
						<div class="text-[11px] text-base-content/60 truncate">Enterprise Deal Pipeline</div>
					</div>
				</div>
			</div>
		</aside>

		<!-- Main Workspace Content Area -->
		<div class="flex-1 flex flex-col min-w-0">
			<!-- Topbar -->
			<header class="h-14 border-b border-base-300 px-6 flex items-center justify-between bg-base-100">
				<div class="flex items-center gap-2 text-sm">
					<span class="font-semibold text-base-content">{title}</span>
				</div>
				<div class="flex items-center gap-3">
					<a href="/" class="btn btn-xs btn-outline">
						+ Plan New Deal
					</a>
				</div>
			</header>

			<!-- Content Slot (Full Width Workspace) -->
			<main class="flex-1 p-6 md:p-8 overflow-y-auto w-full">
				<slot />
			</main>
		</div>
	</body>
</html>
