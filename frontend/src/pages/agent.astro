---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Deal Workflow Pipeline" description="Industrial Multi-Tool Sales Pipeline & DAG Flow Engine">
	<div class="space-y-6 w-full">
		<!-- Standardized Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Autonomous Deal Pipeline</h1>
					<span class="badge badge-sm badge-neutral">High-Throughput Conduits</span>
					<span class="badge badge-sm badge-success" id="pipeline-status-badge">Pressure Nominal (100 PSI)</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					Physical DAG pipeline: parallel processing tubes, manifold splitters, and real-time flow rate monitoring.
				</p>
			</div>
			<!-- Consistent Top-Right Action Buttons -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<button id="btn-purge-pipeline" type="button" class="btn btn-sm btn-outline gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
					<span>Purge Pipeline</span>
				</button>
				<button id="btn-open-valves" type="button" class="btn btn-sm btn-neutral gap-1.5 font-semibold">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
					<span id="valve-btn-text">Open Pipeline Valves</span>
				</button>
			</div>
		</div>

		<!-- Industrial Pipeline Telemetry Bar -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs w-full">
			<div class="card bg-base-200/80 border-2 border-base-300 p-4 space-y-1">
				<span class="text-base-content/60 font-semibold uppercase tracking-wider text-[10px]">Intake Feed</span>
				<div class="font-bold text-sm text-base-content">ACME Corp ($150k ARR)</div>
			</div>
			<div class="card bg-base-200/80 border-2 border-base-300 p-4 space-y-1">
				<span class="text-base-content/60 font-semibold uppercase tracking-wider text-[10px]">Conduit Velocity</span>
				<div class="font-bold text-sm text-success" id="flow-velocity">420 Words / sec</div>
			</div>
			<div class="card bg-base-200/80 border-2 border-base-300 p-4 space-y-1">
				<span class="text-base-content/60 font-semibold uppercase tracking-wider text-[10px]">Manifold Pressure</span>
				<div class="font-bold text-sm text-base-content" id="flow-pressure">98.4 PSI (Optimal)</div>
			</div>
			<div class="card bg-base-200/80 border-2 border-base-300 p-4 space-y-1">
				<span class="text-base-content/60 font-semibold uppercase tracking-wider text-[10px]">Execution Cycle</span>
				<div class="font-bold text-sm text-primary" id="flow-latency">1.12s Concurrent</div>
			</div>
		</div>

		<!-- REAL PIPELINE ARCHITECTURE VISUALIZER -->
		<div class="card bg-base-100 border-2 border-base-300 shadow-md p-6 space-y-6 relative overflow-hidden">
			
			<!-- STAGE 1: INTAKE CHAMBER (Root) -->
			<div class="flex flex-col items-center">
				<div id="chamber-intake" class="pipeline-chamber w-full max-w-lg p-5 rounded-2xl border-2 border-base-300 bg-base-200/90 shadow-md flex items-center justify-between transition-all">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-xl bg-base-300 flex items-center justify-center font-bold text-base-content">
							🚰
						</div>
						<div>
							<div class="flex items-center gap-2">
								<span class="badge badge-xs badge-neutral font-mono">VALVE 01</span>
								<span class="font-bold text-sm text-base-content">Raw Deal Ingestion Valve</span>
							</div>
							<p class="text-xs text-base-content/75 mt-0.5">
								Ingests meeting notes, parses $150k deal size, competitor LegacyVendor, and buyer personas.
							</p>
						</div>
					</div>
					<span class="chamber-status badge badge-xs badge-success shrink-0">Flow Ready</span>
				</div>

				<!-- DOWNWARD VERTICAL PIPE CONDUIT -->
				<div class="h-10 w-4 bg-base-300 relative flex items-center justify-center border-x-2 border-base-content/20">
					<div id="pipe-pulse-1" class="w-1.5 h-full bg-primary/60 transition-all"></div>
				</div>

				<!-- HORIZONTAL DISTRIBUTION MANIFOLD (Splitter) -->
				<div class="w-full max-w-3xl h-4 bg-base-300 border-y-2 border-base-content/20 relative flex items-center justify-between px-8">
					<span class="text-[9px] font-mono uppercase tracking-widest text-base-content/50 mx-auto">
						⚙️ High-Pressure 3-Way Distribution Manifold
					</span>
				</div>
			</div>

			<!-- STAGE 2: PARALLEL REACTOR TUBES (Battlecards, MAP, Financials) -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl mx-auto pt-2">
				
				<!-- TUBE A: Battlecards Chamber -->
				<div class="flex flex-col items-center">
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
					<div id="chamber-battlecards" class="pipeline-chamber w-full p-4 rounded-xl border-2 border-base-300 bg-base-200/70 shadow-sm space-y-2 transition-all">
						<div class="flex items-center justify-between border-b border-base-300 pb-2">
							<div class="flex items-center gap-2">
								<span class="text-base">🛡️</span>
								<span class="font-bold text-xs text-base-content">Objection Chamber</span>
							</div>
							<span class="chamber-status badge badge-xs badge-success">Standby</span>
						</div>
						<p class="text-[11px] text-base-content/75">
							Processes competitive counters & $80k labor savings delta.
						</p>
						<div class="text-[10px] font-mono text-base-content/50 border-t border-base-300 pt-1">
							Output: 4 Talk-Tracks
						</div>
					</div>
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
				</div>

				<!-- TUBE B: MAP Flowchart Chamber -->
				<div class="flex flex-col items-center">
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
					<div id="chamber-map" class="pipeline-chamber w-full p-4 rounded-xl border-2 border-base-300 bg-base-200/70 shadow-sm space-y-2 transition-all">
						<div class="flex items-center justify-between border-b border-base-300 pb-2">
							<div class="flex items-center gap-2">
								<span class="text-base">🗺️</span>
								<span class="font-bold text-xs text-base-content">Roadmap Convector</span>
							</div>
							<span class="chamber-status badge badge-xs badge-success">Standby</span>
						</div>
						<p class="text-[11px] text-base-content/75">
							Generates 6-step closing roadmap & stakeholder owners.
						</p>
						<div class="text-[10px] font-mono text-base-content/50 border-t border-base-300 pt-1">
							Output: 6 Milestones
						</div>
					</div>
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
				</div>

				<!-- TUBE C: cfo.ai Turbine -->
				<div class="flex flex-col items-center">
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
					<div id="chamber-cfo" class="pipeline-chamber w-full p-4 rounded-xl border-2 border-base-300 bg-base-200/70 shadow-sm space-y-2 transition-all">
						<div class="flex items-center justify-between border-b border-base-300 pb-2">
							<div class="flex items-center gap-2">
								<span class="text-base">📊</span>
								<span class="font-bold text-xs text-base-content">cfo.ai ROI Turbine</span>
							</div>
							<span class="chamber-status badge badge-xs badge-success">Standby</span>
						</div>
						<p class="text-[11px] text-base-content/75">
							Calculates $120k ARR contract & &lt;60d break-even horizon.
						</p>
						<div class="text-[10px] font-mono text-base-content/50 border-t border-base-300 pt-1">
							Output: Verified Payback
						</div>
					</div>
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
				</div>
			</div>

			<!-- HORIZONTAL CONVERGENCE MANIFOLD -->
			<div class="w-full max-w-3xl mx-auto h-4 bg-base-300 border-y-2 border-base-content/20 relative flex items-center justify-between">
				<span class="text-[9px] font-mono uppercase tracking-widest text-base-content/50 mx-auto">
					⚡ Convergence Junction (Synthesizes Verified Outputs)
				</span>
			</div>

			<!-- STAGE 3: SYNTHESIS & REFINERY (Email & PPT Decks) -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-3xl mx-auto pt-2">
				<!-- Refinery 1: Proposal Email -->
				<div class="flex flex-col items-center">
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
					<div id="chamber-email" class="pipeline-chamber w-full p-4 rounded-xl border-2 border-base-300 bg-base-200/80 shadow-sm space-y-2 transition-all">
						<div class="flex items-center justify-between border-b border-base-300 pb-2">
							<div class="flex items-center gap-2">
								<span class="text-base">✉️</span>
								<span class="font-bold text-xs text-base-content">Proposal Synthesizer</span>
							</div>
							<span class="chamber-status badge badge-xs badge-success">Standby</span>
						</div>
						<p class="text-[11px] text-base-content/75">
							Distills talk-tracks, milestones, and commercials into ready-to-send executive email.
						</p>
					</div>
				</div>

				<!-- Refinery 2: Pitch Deck -->
				<div class="flex flex-col items-center">
					<div class="h-6 w-4 bg-base-300 border-x-2 border-base-content/20"></div>
					<div id="chamber-deck" class="pipeline-chamber w-full p-4 rounded-xl border-2 border-base-300 bg-base-200/80 shadow-sm space-y-2 transition-all">
						<div class="flex items-center justify-between border-b border-base-300 pb-2">
							<div class="flex items-center gap-2">
								<span class="text-base">📽️</span>
								<span class="font-bold text-xs text-base-content">Deck Extruder (16:9)</span>
							</div>
							<span class="chamber-status badge badge-xs badge-success">Standby</span>
						</div>
						<p class="text-[11px] text-base-content/75">
							Builds structured executive presentation slides with speaker notes.
						</p>
					</div>
				</div>
			</div>

		</div>
	</div>

	<script>
		const openValvesBtn = document.getElementById('btn-open-valves');
		const purgeBtn = document.getElementById('btn-purge-pipeline');
		const valveBtnText = document.getElementById('valve-btn-text');
		const statusBadge = document.getElementById('pipeline-status-badge');
		const velocityText = document.getElementById('flow-velocity');

		const chambers = [
			document.getElementById('chamber-intake'),
			document.getElementById('chamber-battlecards'),
			document.getElementById('chamber-map'),
			document.getElementById('chamber-cfo'),
			document.getElementById('chamber-email'),
			document.getElementById('chamber-deck'),
		];

		function setChamber(el, state) {
			if (!el) return;
			const badge = el.querySelector('.chamber-status');
			if (state === 'idle') {
				el.classList.remove('border-primary', 'bg-primary/10', 'ring-2', 'ring-primary/40');
				el.classList.add('opacity-50');
				if (badge) {
					badge.className = 'chamber-status badge badge-xs badge-ghost';
					badge.textContent = 'Waiting';
				}
			} else if (state === 'flowing') {
				el.classList.remove('opacity-50');
				el.classList.add('border-primary', 'bg-primary/10', 'ring-2', 'ring-primary/40');
				if (badge) {
					badge.className = 'chamber-status badge badge-xs badge-warning';
					badge.textContent = 'Flowing ⚡';
				}
			} else if (state === 'pressurized') {
				el.classList.remove('bg-primary/10', 'ring-2', 'ring-primary/40');
				el.classList.add('bg-base-200/90', 'border-base-300');
				if (badge) {
					badge.className = 'chamber-status badge badge-xs badge-success';
					badge.textContent = 'Pressurized ✓';
				}
			}
		}

		purgeBtn?.addEventListener('click', () => {
			chambers.forEach((c) => setChamber(c, 'idle'));
			if (statusBadge) {
				statusBadge.className = 'badge badge-sm badge-ghost';
				statusBadge.textContent = 'Pipeline Purged';
			}
			if (velocityText) velocityText.textContent = '0 Words / sec';
		});

		openValvesBtn?.addEventListener('click', async () => {
			if (openValvesBtn) (openValvesBtn as HTMLButtonElement).disabled = true;
			if (valveBtnText) valveBtnText.textContent = 'Pumping Conduits...';
			if (statusBadge) {
				statusBadge.className = 'badge badge-sm badge-warning';
				statusBadge.textContent = 'High Pressure Flow (140 PSI)';
			}
			if (velocityText) velocityText.textContent = '560 Words / sec';

			// Step 1: Intake Chamber
			setChamber(chambers[0], 'flowing');
			await new Promise((r) => setTimeout(r, 400));
			setChamber(chambers[0], 'pressurized');

			// Step 2: 3 Parallel Tubes
			setChamber(chambers[1], 'flowing');
			setChamber(chambers[2], 'flowing');
			setChamber(chambers[3], 'flowing');
			await new Promise((r) => setTimeout(r, 650));
			setChamber(chambers[1], 'pressurized');
			setChamber(chambers[2], 'pressurized');
			setChamber(chambers[3], 'pressurized');

			// Step 3: Synthesis Refineries
			setChamber(chambers[4], 'flowing');
			setChamber(chambers[5], 'flowing');
			await new Promise((r) => setTimeout(r, 500));
			setChamber(chambers[4], 'pressurized');
			setChamber(chambers[5], 'pressurized');

			if (statusBadge) {
				statusBadge.className = 'badge badge-sm badge-success';
				statusBadge.textContent = 'Pressure Nominal (100 PSI)';
			}
			if (velocityText) velocityText.textContent = '420 Words / sec';
			if (valveBtnText) valveBtnText.textContent = 'Open Pipeline Valves';
			if (openValvesBtn) (openValvesBtn as HTMLButtonElement).disabled = false;
		});
	</script>
</Layout>
