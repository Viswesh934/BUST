---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Deal Follow-Up Emails" description="Executive Proposal Follow-Up Emails & Outreach">
	<div class="space-y-6 w-full">
		<!-- Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Deal Follow-Up Emails</h1>
					<span class="badge badge-sm badge-neutral" id="email-counter-badge">Active Repository</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					High-impact executive follow-up and proposal emails composed autonomously by the AI Sales Agent.
				</p>
			</div>
			<!-- Top-Right Actions -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<a href="/" class="btn btn-sm btn-neutral gap-1.5 font-semibold">
					<span>← Back to Plan</span>
				</a>
			</div>
		</div>

		<!-- LOADING STATE -->
		<div id="loading-state" class="py-16 text-center space-y-3">
			<span class="loading loading-spinner loading-md text-primary"></span>
			<p class="text-xs text-base-content/60 font-mono">Loading emails from agent artifact store...</p>
		</div>

		<!-- EMPTY STATE (Zero mock data) -->
		<div id="empty-state" class="hidden py-16 flex flex-col items-center justify-center text-center space-y-4">
			<div class="w-16 h-16 rounded-2xl bg-base-200 border-2 border-base-300 flex items-center justify-center text-3xl shadow-xs">
				✉️
			</div>
			<div class="max-w-md space-y-1.5">
				<h3 class="font-bold text-base text-base-content">No Emails Generated Yet</h3>
				<p class="text-xs text-base-content/75 leading-relaxed">
					Proposal emails are drafted dynamically from your deal directives. Instruct the AI agent in Plan to generate follow-up communications.
				</p>
			</div>
			<a href="/" class="btn btn-sm btn-neutral font-semibold">
				Go to Plan ⚡
			</a>
		</div>

		<!-- REAL EMAILS CONTAINER (Populated dynamically) -->
		<div id="emails-container" class="hidden space-y-6">
			<!-- Dynamically injected -->
		</div>
	</div>

	<script>
		const loadingState = document.getElementById('loading-state');
		const emptyState = document.getElementById('empty-state');
		const emailsContainer = document.getElementById('emails-container');
		const counterBadge = document.getElementById('email-counter-badge');

		async function loadEmails() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) throw new Error('Failed to fetch artifacts');
				const artifacts = await res.json();
				const emailArtifacts = artifacts.filter((a: any) => a.type === 'email');

				if (loadingState) loadingState.classList.add('hidden');

				if (!emailArtifacts.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				if (emailsContainer) emailsContainer.classList.remove('hidden');
				if (counterBadge) counterBadge.textContent = `${emailArtifacts.length} Active Drafts`;

				let html = '';
				emailArtifacts.forEach((art: any) => {
					const em = art.content || {};
					html += `
						<div class="card bg-base-100 border-2 border-base-300 p-6 rounded-2xl shadow-sm space-y-4">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-base-200 pb-3">
								<div>
									<h3 class="font-bold text-base text-base-content">${art.title || 'Executive Proposal Email'}</h3>
									<span class="text-xs text-base-content/60 font-mono">To: ${em.to || art.deal_context?.recipient || 'Decision Maker'}</span>
								</div>
								<div class="flex items-center gap-2">
									<button class="btn btn-xs btn-outline copy-email-btn" data-body="${encodeURIComponent(em.body || '')}">
										📋 Copy Text
									</button>
								</div>
							</div>

							<div class="space-y-3">
								<div class="p-3 rounded-xl bg-base-200/80 border border-base-300 text-xs">
									<span class="text-base-content/60 font-bold">Subject: </span>
									<span class="font-bold text-base-content">${em.subject || 'Executive Proposal'}</span>
								</div>

								<pre class="p-5 rounded-2xl bg-base-200/60 border border-base-300 font-sans text-xs text-base-content leading-relaxed whitespace-pre-wrap">${em.body || ''}</pre>
							</div>
						</div>
					`;
				});

				if (emailsContainer) emailsContainer.innerHTML = html;

				document.querySelectorAll('.copy-email-btn').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const target = e.currentTarget as HTMLButtonElement;
						const encoded = target.getAttribute('data-body') || '';
						navigator.clipboard.writeText(decodeURIComponent(encoded)).then(() => {
							const orig = target.textContent;
							target.textContent = 'Copied! ✓';
							setTimeout(() => (target.textContent = orig), 2000);
						});
					});
				});
			} catch (err) {
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		loadEmails();
	</script>
</Layout>
