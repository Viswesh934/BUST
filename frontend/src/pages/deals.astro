---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Buyer Deal Rooms" description="Luxury Deal Suites & Keycard Access Portals">
	<div class="space-y-6 w-full">
		<!-- Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Buyer Deal Rooms</h1>
					<span class="badge badge-sm badge-neutral" id="suites-counter-badge">Active Suites</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					Private read-only buyer suites with encrypted digital keycard passes, provisioned autonomously by the AI Sales Agent.
				</p>
			</div>
			<!-- Top-Right Actions -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<a href="/" class="btn btn-sm btn-neutral gap-1.5 font-semibold">
					<span>← Back to Plan</span>
				</a>
			</div>
		</div>

		<!-- LOADING STATE -->
		<div id="loading-state" class="py-16 text-center space-y-3">
			<span class="loading loading-spinner loading-md text-primary"></span>
			<p class="text-xs text-base-content/60 font-mono">Loading deal suites from agent artifact store...</p>
		</div>

		<!-- EMPTY STATE (Zero mock data) -->
		<div id="empty-state" class="hidden py-16 flex flex-col items-center justify-center text-center space-y-4">
			<div class="w-16 h-16 rounded-2xl bg-base-200 border-2 border-base-300 flex items-center justify-center text-3xl shadow-xs">
				🏨
			</div>
			<div class="max-w-md space-y-1.5">
				<h3 class="font-bold text-base text-base-content">No Buyer Deal Rooms Issued Yet</h3>
				<p class="text-xs text-base-content/75 leading-relaxed">
					Buyer deal rooms with guest keycard tokens are issued dynamically when an opportunity is prepared. Instruct the AI agent in Plan to publish a buyer deal suite.
				</p>
			</div>
			<a href="/" class="btn btn-sm btn-neutral font-semibold">
				Go to Plan ⚡
			</a>
		</div>

		<!-- REAL SUITES CONTAINER (Populated dynamically) -->
		<div id="suites-container" class="hidden space-y-6">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="suites-grid">
				<!-- Dynamically injected -->
			</div>
		</div>
	</div>

	<script>
		const loadingState = document.getElementById('loading-state');
		const emptyState = document.getElementById('empty-state');
		const suitesContainer = document.getElementById('suites-container');
		const suitesGrid = document.getElementById('suites-grid');
		const counterBadge = document.getElementById('suites-counter-badge');

		async function loadSuites() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) throw new Error('Failed to fetch artifacts');
				const artifacts = await res.json();
				const publishedSuites = artifacts.filter((a: any) => a.is_published && a.share_id);

				if (loadingState) loadingState.classList.add('hidden');

				if (!publishedSuites.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				if (suitesContainer) suitesContainer.classList.remove('hidden');
				if (counterBadge) counterBadge.textContent = `${publishedSuites.length} Active Suites`;

				let html = '';
				publishedSuites.forEach((art: any) => {
					html += `
						<div class="card bg-base-100 border-2 border-base-300 p-6 rounded-2xl shadow-sm space-y-4 flex flex-col justify-between">
							<div class="space-y-3">
								<div class="flex items-center justify-between border-b border-base-200 pb-2.5">
									<span class="badge badge-xs badge-success font-semibold">Keycard Active</span>
									<span class="text-[10px] font-mono text-base-content/60">Read-Only Guest Pass</span>
								</div>

								<div class="flex items-center gap-3">
									<div class="w-12 h-12 rounded-xl bg-neutral text-neutral-content flex items-center justify-center text-xl font-bold shadow-xs">
										🏨
									</div>
									<div>
										<h4 class="font-bold text-sm text-base-content">Penthouse Suite: ${art.deal_context?.account_name || art.title}</h4>
										<p class="text-xs font-mono text-base-content/60">Pass: ${art.share_id}</p>
									</div>
								</div>

								<p class="text-xs text-base-content/75 leading-relaxed">
									Dedicated buyer room containing verified objection talk-tracks, mutual action plans, and commercials for decision-makers.
								</p>
							</div>

							<div class="pt-2 flex items-center gap-2">
								<a href="/suite/${art.share_id}" target="_blank" class="btn btn-sm btn-neutral flex-1 font-semibold">
									Enter Suite As Guest 🚪
								</a>
							</div>
						</div>
					`;
				});

				if (suitesGrid) suitesGrid.innerHTML = html;
			} catch (err) {
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		loadSuites();
	</script>
</Layout>
