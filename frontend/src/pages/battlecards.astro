---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Objection Battlecards" description="Physical Stacked Deck & AE Pitch Practice Mode">
	<div class="space-y-6 w-full">
		<!-- Standardized Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Objection Battlecards</h1>
					<span class="badge badge-sm badge-neutral" id="deck-counter-badge">Card 1 of 4</span>
					<span class="badge badge-sm badge-success">Stacked Deck Active</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					Physical stacked card deck: flip to practice winning talk-tracks, then draw next card to cycle the deck.
				</p>
			</div>
			<!-- Consistent Top-Right Action Buttons -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<button id="btn-toggle-view" type="button" class="btn btn-sm btn-outline gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
					<span id="view-mode-text">Switch to Grid View</span>
				</button>
				<button id="btn-add-card" type="button" class="btn btn-sm btn-neutral gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
					<span>Add Objection</span>
				</button>
			</div>
		</div>

		<!-- STACKED DECK CONTAINER VIEW -->
		<div id="stacked-deck-view" class="flex flex-col items-center justify-center py-6 w-full">
			<!-- Stack Deck Controls Bar -->
			<!-- Stack Deck Controls Bar -->
			<div class="flex items-center justify-between w-full max-w-xl mb-3 px-2">
				<div class="flex items-center gap-2 text-xs">
					<span class="font-bold text-base-content">Stack Depth: 4 Cards</span>
					<span class="text-base-content/40">•</span>
					<span class="text-base-content/75 font-medium">Click card to flip</span>
				</div>
				<div class="flex items-center gap-1.5">
					<button id="btn-flip-card" type="button" class="btn btn-xs btn-outline">
						Flip Card 🔄
					</button>
					<button id="btn-prev-card" type="button" class="btn btn-xs btn-outline w-8 h-8 rounded-full p-0 font-bold text-sm" title="Previous Card" aria-label="Previous Card">
						❮
					</button>
					<button id="btn-next-card" type="button" class="btn btn-xs btn-neutral w-8 h-8 rounded-full p-0 font-bold text-sm" title="Next Card" aria-label="Next Card">
						❯
					</button>
				</div>
			</div>

			<!-- Physical Stack Container with Overlapping Elevation and Prominent Side Navigation Arrows -->
			<div class="relative w-full max-w-2xl flex items-center justify-center my-2">
				
				<!-- Floating Left Arrow (Like PPT) -->
				<button
					id="btn-floating-card-prev"
					type="button"
					class="absolute left-0 md:-left-6 top-1/2 -translate-y-1/2 w-11 h-11 md:w-13 md:h-13 rounded-full bg-base-100 hover:bg-base-200 border-2 border-base-300 shadow-xl flex items-center justify-center font-black text-xl text-base-content hover:scale-110 active:scale-95 transition-all z-40 cursor-pointer"
					title="Previous Card"
					aria-label="Previous Card"
				>
					❮
				</button>

				<!-- Floating Right Arrow (Like PPT) -->
				<button
					id="btn-floating-card-next"
					type="button"
					class="absolute right-0 md:-right-6 top-1/2 -translate-y-1/2 w-11 h-11 md:w-13 md:h-13 rounded-full bg-base-100 hover:bg-base-200 border-2 border-base-300 shadow-xl flex items-center justify-center font-black text-xl text-base-content hover:scale-110 active:scale-95 transition-all z-40 cursor-pointer"
					title="Next Card"
					aria-label="Next Card"
				>
					❯
				</button>

				<!-- Stack Deck Stage -->
				<div class="relative w-full max-w-xl h-96 perspective-1000" id="deck-stage">
				
				<!-- CARD 1 (Top / Pricing) -->
				<div class="card-stack-item absolute inset-0 z-30 transition-all duration-500 cursor-pointer" data-index="0">
					<div class="flip-card h-full w-full">
						<div class="flip-card-inner h-full w-full relative">
							<!-- FRONT -->
							<div class="absolute inset-0 backface-hidden p-7 rounded-2xl border-2 border-base-300 bg-base-100 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-200 pb-3">
									<div class="flex items-center gap-2">
										<span class="badge badge-sm badge-neutral font-semibold">Pricing / Budget</span>
										<span class="badge badge-sm badge-outline">Card #1</span>
									</div>
									<span class="text-xs font-mono text-base-content/60">Click to Flip 🔄</span>
								</div>

								<div class="space-y-2.5 my-auto">
									<span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Prospect Objection:</span>
									<p class="text-lg font-bold text-base-content leading-snug">
										"Your quote is 20% higher than our renewal price from LegacyVendor."
									</p>
									<p class="text-xs text-base-content/75 font-medium">
										Persona: VP of Sales Operations & Procurement
									</p>
								</div>

								<div class="pt-3 border-t border-base-200 flex items-center justify-between">
									<div class="flex gap-1.5">
										<span class="badge badge-xs badge-neutral">TCO Comparison</span>
										<span class="badge badge-xs badge-outline">2 FTE Savings</span>
									</div>
									<span class="text-xs font-semibold text-base-content/80 hover:underline">Tap to reveal talk-track →</span>
								</div>
							</div>

							<!-- BACK -->
							<div class="absolute inset-0 backface-hidden rotate-y-180 p-7 rounded-2xl border-2 border-primary/30 bg-base-200 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-300 pb-3">
									<span class="badge badge-sm badge-success font-bold">Winning Executive Talk-Track</span>
									<span class="text-xs font-mono text-base-content/60">Tap to Flip Back ↺</span>
								</div>

								<div class="space-y-3 my-auto">
									<p class="text-xs text-base-content leading-relaxed bg-base-100 p-4 rounded-xl border border-base-300 shadow-2xs font-medium">
										"While our upfront subscription is 20% higher, LegacyVendor requires an estimated 2 full-time sales ops staff just to maintain manual data sync. BUST automates that workflow entirely, delivering a net operational savings of $80,000 in Year 1."
									</p>
									<div class="grid grid-cols-2 gap-2 text-xs">
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Proof Point:</strong> $80k net savings
										</div>
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">cfo.ai Metric:</strong> 60-day break-even
										</div>
									</div>
								</div>

								<div class="pt-3 border-t border-base-300 flex items-center justify-between">
									<span class="text-xs text-base-content/70">AE Confidence:</span>
									<div class="flex gap-1.5">
										<button class="btn btn-xs btn-outline">Needs Work</button>
										<button class="btn btn-xs btn-neutral">Mastered ✓</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- CARD 2 (Stacked behind / Security) -->
				<div class="card-stack-item absolute inset-0 z-20 translate-y-3 scale-96 opacity-90 transition-all duration-500 cursor-pointer" data-index="1">
					<div class="flip-card h-full w-full">
						<div class="flip-card-inner h-full w-full relative">
							<!-- FRONT -->
							<div class="absolute inset-0 backface-hidden p-7 rounded-2xl border-2 border-base-300 bg-base-100 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-200 pb-3">
									<div class="flex items-center gap-2">
										<span class="badge badge-sm badge-neutral font-semibold">Security & InfoSec</span>
										<span class="badge badge-sm badge-outline">Card #2</span>
									</div>
									<span class="text-xs font-mono text-base-content/60">Click to Flip 🔄</span>
								</div>

								<div class="space-y-2.5 my-auto">
									<span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Prospect Objection:</span>
									<p class="text-lg font-bold text-base-content leading-snug">
										"Our InfoSec board will not approve any AI software that trains models on enterprise deal data."
									</p>
									<p class="text-xs text-base-content/75 font-medium">
										Persona: Chief Information Security Officer (CISO)
									</p>
								</div>

								<div class="pt-3 border-t border-base-200 flex items-center justify-between">
									<div class="flex gap-1.5">
										<span class="badge badge-xs badge-neutral">SOC2 Type II</span>
										<span class="badge badge-xs badge-outline">Zero Retention</span>
									</div>
									<span class="text-xs font-semibold text-base-content/80 hover:underline">Tap to reveal talk-track →</span>
								</div>
							</div>

							<!-- BACK -->
							<div class="absolute inset-0 backface-hidden rotate-y-180 p-7 rounded-2xl border-2 border-primary/30 bg-base-200 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-300 pb-3">
									<span class="badge badge-sm badge-success font-bold">Winning Executive Talk-Track</span>
									<span class="text-xs font-mono text-base-content/60">Tap to Flip Back ↺</span>
								</div>

								<div class="space-y-3 my-auto">
									<p class="text-xs text-base-content leading-relaxed bg-base-100 p-4 rounded-xl border border-base-300 shadow-2xs font-medium">
										"We operate under a strict Zero Data Retention policy with regional AWS isolation. Customer data is processed ephemerally in-memory and is never used for model training. Our independent SOC2 Type II audit report is available in our Trust Center."
									</p>
									<div class="grid grid-cols-2 gap-2 text-xs">
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Certification:</strong> SOC2 Type II Audited
										</div>
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Tenancy:</strong> Dedicated Regional Private Cloud
										</div>
									</div>
								</div>

								<div class="pt-3 border-t border-base-300 flex items-center justify-between">
									<span class="text-xs text-base-content/70">AE Confidence:</span>
									<div class="flex gap-1.5">
										<button class="btn btn-xs btn-outline">Needs Work</button>
										<button class="btn btn-xs btn-neutral">Mastered ✓</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- CARD 3 (Stacked behind / Competitor) -->
				<div class="card-stack-item absolute inset-0 z-10 translate-y-6 scale-92 opacity-75 transition-all duration-500 cursor-pointer" data-index="2">
					<div class="flip-card h-full w-full">
						<div class="flip-card-inner h-full w-full relative">
							<!-- FRONT -->
							<div class="absolute inset-0 backface-hidden p-7 rounded-2xl border-2 border-base-300 bg-base-100 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-200 pb-3">
									<div class="flex items-center gap-2">
										<span class="badge badge-sm badge-neutral font-semibold">Competitor Trap</span>
										<span class="badge badge-sm badge-outline">Card #3</span>
									</div>
									<span class="text-xs font-mono text-base-content/60">Click to Flip 🔄</span>
								</div>

								<div class="space-y-2.5 my-auto">
									<span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Prospect Objection:</span>
									<p class="text-lg font-bold text-base-content leading-snug">
										"LegacyVendor claims they already have an AI feature built into their existing platform."
									</p>
									<p class="text-xs text-base-content/75 font-medium">
										Persona: Director of Enterprise Sales
									</p>
								</div>

								<div class="pt-3 border-t border-base-200 flex items-center justify-between">
									<div class="flex gap-1.5">
										<span class="badge badge-xs badge-neutral">Point Solution vs Suite</span>
										<span class="badge badge-xs badge-outline">DAG Architecture</span>
									</div>
									<span class="text-xs font-semibold text-base-content/80 hover:underline">Tap to reveal talk-track →</span>
								</div>
							</div>

							<!-- BACK -->
							<div class="absolute inset-0 backface-hidden rotate-y-180 p-7 rounded-2xl border-2 border-primary/30 bg-base-200 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-300 pb-3">
									<span class="badge badge-sm badge-success font-bold">Winning Executive Talk-Track</span>
									<span class="text-xs font-mono text-base-content/60">Tap to Flip Back ↺</span>
								</div>

								<div class="space-y-3 my-auto">
									<p class="text-xs text-base-content leading-relaxed bg-base-100 p-4 rounded-xl border border-base-300 shadow-2xs font-medium">
										"LegacyVendor's add-on is a basic autocomplete box. BUST is an autonomous orchestration engine that takes one instruction and coordinates the generation, schema validation, and alignment of 4 full deliverables simultaneously."
									</p>
									<div class="grid grid-cols-2 gap-2 text-xs">
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Differentiator:</strong> End-to-end Deliverables
										</div>
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Execution:</strong> Deterministic DAG Workflow
										</div>
									</div>
								</div>

								<div class="pt-3 border-t border-base-300 flex items-center justify-between">
									<span class="text-xs text-base-content/70">AE Confidence:</span>
									<div class="flex gap-1.5">
										<button class="btn btn-xs btn-outline">Needs Work</button>
										<button class="btn btn-xs btn-neutral">Mastered ✓</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- CARD 4 (Stacked at the base / Budget) -->
				<div class="card-stack-item absolute inset-0 z-0 translate-y-9 scale-88 opacity-60 transition-all duration-500 cursor-pointer" data-index="3">
					<div class="flip-card h-full w-full">
						<div class="flip-card-inner h-full w-full relative">
							<!-- FRONT -->
							<div class="absolute inset-0 backface-hidden p-7 rounded-2xl border-2 border-base-300 bg-base-100 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-200 pb-3">
									<div class="flex items-center gap-2">
										<span class="badge badge-sm badge-neutral font-semibold">Budget Horizon</span>
										<span class="badge badge-sm badge-outline">Card #4</span>
									</div>
									<span class="text-xs font-mono text-base-content/60">Click to Flip 🔄</span>
								</div>

								<div class="space-y-2.5 my-auto">
									<span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Prospect Objection:</span>
									<p class="text-lg font-bold text-base-content leading-snug">
										"We did not allocate budget for new sales enablement software this fiscal quarter."
									</p>
									<p class="text-xs text-base-content/75 font-medium">
										Persona: CFO / VP of Finance
									</p>
								</div>

								<div class="pt-3 border-t border-base-200 flex items-center justify-between">
									<div class="flex gap-1.5">
										<span class="badge badge-xs badge-neutral">cfo.ai Projections</span>
										<span class="badge badge-xs badge-outline">Milestone Terms</span>
									</div>
									<span class="text-xs font-semibold text-base-content/80 hover:underline">Tap to reveal talk-track →</span>
								</div>
							</div>

							<!-- BACK -->
							<div class="absolute inset-0 backface-hidden rotate-y-180 p-7 rounded-2xl border-2 border-primary/30 bg-base-200 flex flex-col justify-between shadow-xl">
								<div class="flex items-center justify-between border-b border-base-300 pb-3">
									<span class="badge badge-sm badge-success font-bold">Winning Executive Talk-Track</span>
									<span class="text-xs font-mono text-base-content/60">Tap to Flip Back ↺</span>
								</div>

								<div class="space-y-3 my-auto">
									<p class="text-xs text-base-content leading-relaxed bg-base-100 p-4 rounded-xl border border-base-300 shadow-2xs font-medium">
										"Our commercial rollout requires zero new unallocated budget: we structure payment terms upon the first closed deal milestone. With an average deal acceleration of 18 days, our customers recover 100% of the cost within their existing pipeline cycle."
									</p>
									<div class="grid grid-cols-2 gap-2 text-xs">
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Structure:</strong> Milestone Payback Terms
										</div>
										<div class="p-2 rounded-lg bg-base-100 border border-base-300">
											<strong class="text-base-content">Payback:</strong> Within existing quarter
										</div>
									</div>
								</div>

								<div class="pt-3 border-t border-base-300 flex items-center justify-between">
									<span class="text-xs text-base-content/70">AE Confidence:</span>
									<div class="flex gap-1.5">
										<button class="btn btn-xs btn-outline">Needs Work</button>
										<button class="btn btn-xs btn-neutral">Mastered ✓</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

		<!-- ALTERNATIVE EXPANDED GRID VIEW (Initially hidden) -->
		<div id="grid-deck-view" class="hidden grid grid-cols-1 md:grid-cols-2 gap-5 w-full">
			<!-- Rendered dynamically or copied when toggled -->
		</div>
	</div>

	<script>
		// Stack Management Logic
		const stackItems = Array.from(document.querySelectorAll('.card-stack-item'));
		const deckCounterBadge = document.getElementById('deck-counter-badge');
		const btnNext = document.getElementById('btn-next-card');
		const btnPrev = document.getElementById('btn-prev-card');
		const btnFlip = document.getElementById('btn-flip-card');
		const btnToggleView = document.getElementById('btn-toggle-view');
		const viewModeText = document.getElementById('view-mode-text');
		const stackedView = document.getElementById('stacked-deck-view');
		const gridView = document.getElementById('grid-deck-view');

		let currentOrder = [0, 1, 2, 3];
		let isGridView = false;

		function updateStackPositions() {
			stackItems.forEach((card, originalIdx) => {
				const pos = currentOrder.indexOf(originalIdx);
				const flipCard = card.querySelector('.flip-card');

				if (pos === 0) {
					// Top card: fully interactive
					card.style.zIndex = '30';
					card.style.transform = 'translateY(0) scale(1)';
					card.style.opacity = '1';
					card.style.pointerEvents = 'auto';
				} else if (pos === 1) {
					// Second card in stack
					card.style.zIndex = '20';
					card.style.transform = 'translateY(14px) scale(0.96)';
					card.style.opacity = '0.9';
					card.style.pointerEvents = 'none';
					flipCard?.classList.remove('is-flipped');
				} else if (pos === 2) {
					// Third card in stack
					card.style.zIndex = '10';
					card.style.transform = 'translateY(28px) scale(0.92)';
					card.style.opacity = '0.75';
					card.style.pointerEvents = 'none';
					flipCard?.classList.remove('is-flipped');
				} else {
					// Fourth card
					card.style.zIndex = '0';
					card.style.transform = 'translateY(42px) scale(0.88)';
					card.style.opacity = '0.55';
					card.style.pointerEvents = 'none';
					flipCard?.classList.remove('is-flipped');
				}
			});

			if (deckCounterBadge) {
				const topCardNum = currentOrder[0] + 1;
				deckCounterBadge.textContent = `Card ${topCardNum} of ${stackItems.length}`;
			}
		}

		// Click to flip active top card
		stackItems.forEach((item, idx) => {
			item.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (target.tagName === 'BUTTON') return;
				if (currentOrder[0] === idx) {
					const flipCard = item.querySelector('.flip-card');
					flipCard?.classList.toggle('is-flipped');
				}
			});
		});

		// Flip Button
		btnFlip?.addEventListener('click', () => {
			const activeIdx = currentOrder[0];
			const activeCard = stackItems[activeIdx];
			const flipCard = activeCard.querySelector('.flip-card');
			flipCard?.classList.toggle('is-flipped');
		});

		// Floating Side Arrows (Like PPT)
		const floatingPrev = document.getElementById('btn-floating-card-prev');
		const floatingNext = document.getElementById('btn-floating-card-next');

		function advanceNextCard() {
			const activeIdx = currentOrder[0];
			const activeCard = stackItems[activeIdx];
			const flipCard = activeCard.querySelector('.flip-card');
			flipCard?.classList.remove('is-flipped');

			// Slide animation to the right
			activeCard.style.transform = 'translateX(120%) rotate(15deg) scale(0.9)';
			activeCard.style.opacity = '0';

			setTimeout(() => {
				const first = currentOrder.shift()!;
				currentOrder.push(first);
				updateStackPositions();
			}, 280);
		}

		function advancePrevCard() {
			const last = currentOrder.pop()!;
			currentOrder.unshift(last);
			updateStackPositions();
		}

		// Next Card triggers
		btnNext?.addEventListener('click', advanceNextCard);
		floatingNext?.addEventListener('click', advanceNextCard);

		// Prev Card triggers
		btnPrev?.addEventListener('click', advancePrevCard);
		floatingPrev?.addEventListener('click', advancePrevCard);

		// Toggle View: Stack vs Grid
		btnToggleView?.addEventListener('click', () => {
			isGridView = !isGridView;
			if (isGridView) {
				stackedView?.classList.add('hidden');
				gridView?.classList.remove('hidden');
				if (viewModeText) viewModeText.textContent = 'Switch to Stacked Deck';
			} else {
				gridView?.classList.add('hidden');
				stackedView?.classList.remove('hidden');
				if (viewModeText) viewModeText.textContent = 'Switch to Grid View';
			}
		});

		// Initialize
		updateStackPositions();
	</script>
</Layout>
