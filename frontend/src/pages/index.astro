				if (deck > 0) appBadgeDeck.classList.remove('hidden');
			}

			const email = storedArtifacts.email ? 1 : 0;
			if (appBadgeEmail) {
				appBadgeEmail.textContent = email.toString();
				if (email > 0) appBadgeEmail.classList.remove('hidden');
			}

			const map = storedArtifacts.flowchart?.content?.stages?.length || 0;
			if (appBadgeMap) {
				appBadgeMap.textContent = map.toString();
				if (map > 0) appBadgeMap.classList.remove('hidden');
				else appBadgeMap.classList.add('hidden');
			}

			const social = storedArtifacts.social ? 1 : 0;
			if (appBadgeSocial) {
				appBadgeSocial.textContent = social.toString();
				if (social > 0) appBadgeSocial.classList.remove('hidden');
				else appBadgeSocial.classList.add('hidden');
			}

			const suite = storedArtifacts.suite ? 1 : 0;
			if (appBadgeSuite) {
				appBadgeSuite.textContent = suite.toString();
				if (suite > 0) appBadgeSuite.classList.remove('hidden');
				else appBadgeSuite.classList.add('hidden');
			}
		}

		// Append User Message
		function appendUserMessage(text: string) {
			if (!chatStream) return;
			if (welcomeTurn) welcomeTurn.classList.add('hidden');

			const escaped = text
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');

			const turnDiv = document.createElement('div');
			turnDiv.className = 'flex justify-end';
			turnDiv.innerHTML = `
				<div class="p-3.5 sm:p-4 bg-neutral text-neutral-content rounded-2xl text-xs sm:text-sm font-medium leading-relaxed max-w-[85%] shadow-xs break-words whitespace-pre-wrap">
					${escaped}
				</div>
			`;
			chatStream.appendChild(turnDiv);
			chatStream.scrollTop = chatStream.scrollHeight;
		}

		// Append Progress Block
		function appendProgressBlock(): HTMLDivElement | null {
			if (!chatStream) return null;
			const progDiv = document.createElement('div');
			progDiv.className = 'p-4 bg-base-200/80 rounded-2xl border border-base-300 animate-pulse text-xs max-w-xl space-y-2';
			progDiv.innerHTML = `
				<div class="flex items-center gap-2 font-bold text-base-content">
					<span class="loading loading-spinner loading-xs text-primary"></span>
					<span>Analyzing deal directives & formulating plan...</span>
				</div>
				<div class="font-mono text-[11px] text-base-content/70 space-y-0.5">
					<div>● Evaluating competitive context & ROI requirements...</div>
					<div>● Dispatching deterministic tools to DAG engine...</div>
				</div>
			`;
			chatStream.appendChild(progDiv);
			chatStream.scrollTop = chatStream.scrollHeight;
			return progDiv;
		}

		// Append Agent Response with Smart Follow-up Questions
		function appendAgentTurn(data: any) {
			if (!chatStream) return;
			const turnDiv = document.createElement('div');
			turnDiv.className = 'space-y-3.5 w-full min-w-0';

			// Record in conversation history for multi-turn cognitive context
			if (data.agent_reply) {
				conversationHistory.push({ role: 'assistant', content: data.agent_reply });
			}

			// Update Deal Context & Badges
			if (data.deal_context) {
				dealContext = { ...dealContext, ...data.deal_context };
				if (dealTitleBadge) {
					dealTitleBadge.textContent = `${dealContext.account_name || 'Opportunity'} (${dealContext.deal_size || ''})`;
				}
				if (dealStageBadge) {
					const stage = dealContext.deal_stage || dealContext.stage;
					if (stage) {
						dealStageBadge.textContent = stage;
						dealStageBadge.classList.remove('hidden');
					}
				}
				if (dealHealthBadge) {
					const health = dealContext.health_status || dealContext.health;
					if (health) {
						dealHealthBadge.textContent = health;
						dealHealthBadge.classList.remove('hidden');
						dealHealthBadge.className = 'badge badge-xs font-mono font-semibold ';
						if (health.toLowerCase().includes('risk')) {
							dealHealthBadge.className += 'badge-error text-white';
						} else if (health.toLowerCase().includes('strong') || health.toLowerCase().includes('healthy')) {
							dealHealthBadge.className += 'badge-success text-white';
						} else {
							dealHealthBadge.className += 'badge-warning';
						}
					}
				}
			}

			// Store new artifacts and switch to side view
			const arts = data.artifacts || {};
			const newKeys = Object.keys(arts);
			if (newKeys.length > 0) {
				storedArtifacts = { ...storedArtifacts, ...arts };
				updateSideBadges();
				setSidePanelState(true);
				switchAppTab(newKeys[0]);
			}

			// Tactical Decision Rationale Callout
			let rationaleHtml = '';
			if (data.decision_rationale) {
				rationaleHtml = `
					<div class="p-3 bg-base-200/90 rounded-xl border border-base-300 text-xs space-y-1.5 font-sans min-w-0 break-words">
						<div class="flex items-center justify-between text-[11px] font-bold text-base-content/80 uppercase tracking-wider gap-2">
							<span class="flex items-center gap-1.5 shrink-0">🧠 Tactical Decision Rationale</span>
							${data.primary_risk ? `<span class="text-error font-medium normal-case truncate">⚠️ Risk: ${data.primary_risk}</span>` : ''}
						</div>
						<div class="text-base-content/85 leading-relaxed markdown-content">${renderMarkdown(data.decision_rationale)}</div>
					</div>
				`;
			}

			// Generated deliverables pill banner
			let generatedPillsHtml = '';
			if (newKeys.length > 0) {
				generatedPillsHtml = `
					<div class="flex flex-wrap items-center gap-1.5 pt-1">
						<span class="text-[11px] font-semibold text-base-content/70">Generated Deliverables:</span>
						${newKeys.map((k) => {
							const labels: Record<string, string> = {
								battlecards: '🎴 Battlecards',
								competitor: '🎯 Competitor Intelligence',
								presentation: '📊 Pitch Deck',
								email: '✉️ Proposal Email',
								flowchart: '🗺️ Mutual Action Plan',
								social: '🐦 Social Touchpoint',
								suite: '🏨 Deal Suite'
							};
							return `
								<button class="side-inspect-pill btn btn-xs btn-neutral gap-1 cursor-pointer" data-tab="${k}">
									<span>${labels[k] || k}</span>
									<span>→</span>
								</button>
							`;
						}).join('')}
					</div>
				`;
			}

			// Follow-up Suggestions
			const followUps = data.follow_ups || [];
			let followUpsHtml = '';
			if (followUps.length > 0) {
				followUpsHtml = `
					<div class="mt-3 pt-3 border-t border-base-200/80 space-y-2">
						<div class="flex items-center gap-1.5 text-[11px] font-semibold text-base-content/75">
							<span>💡 Recommended Next Deliverables:</span>
						</div>
						<div class="flex flex-wrap gap-1.5">
							${followUps.map((fu: any) => `
								<button class="followup-chip btn btn-xs btn-outline rounded-full font-medium text-[11px] transition-all hover:btn-neutral cursor-pointer" data-prompt="${fu.prompt}">
									${fu.label}
								</button>
							`).join('')}
						</div>
					</div>
				`;
			}

			turnDiv.innerHTML = `
				<div class="card bg-base-100 border border-base-200/90 p-4 sm:p-5 rounded-2xl shadow-xs space-y-3 min-w-0 break-words overflow-hidden">
					<div class="text-xs sm:text-sm text-base-content leading-relaxed font-medium markdown-content min-w-0 break-words">
						${renderMarkdown(data.agent_reply || 'Plan executed.')}
					</div>
					${rationaleHtml}
					${generatedPillsHtml}
					${followUpsHtml}
				</div>
			`;

			chatStream.appendChild(turnDiv);
			chatStream.scrollTop = chatStream.scrollHeight;

			// Attach listener to pills
			turnDiv.querySelectorAll('.side-inspect-pill').forEach((pill) => {
				pill.addEventListener('click', () => {
					const tabKey = pill.getAttribute('data-tab') || 'battlecards';
					switchAppTab(tabKey);
				});
			});

			// Attach listener to follow-up suggestion chips
			turnDiv.querySelectorAll('.followup-chip').forEach((chip) => {
				chip.addEventListener('click', () => {
					const prompt = chip.getAttribute('data-prompt');
					if (prompt) submitPrompt(prompt);
				});
			});
		}

		// Core Submit Prompt with Multi-Turn Context Pipelining
		async function submitPrompt(promptText: string) {
			const text = promptText.trim();
			if (!text) return;

			if (chatInput) chatInput.value = '';
			appendUserMessage(text);
			conversationHistory.push({ role: 'user', content: text });
			const progBlock = appendProgressBlock();

			if (sendBtn) {
				sendBtn.setAttribute('disabled', 'true');
				sendBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';
			}

			try {
				const res = await fetch('/api/agent/run', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						message: text,
						deal_context: dealContext,
						history: conversationHistory.slice(-8),
					}),
				});

				if (!res.ok) throw new Error(`HTTP error ${res.status}`);
				const data = await res.json();
				if (progBlock) progBlock.remove();
				appendAgentTurn(data);
			} catch (err: any) {
				if (progBlock) progBlock.remove();
				const errDiv = document.createElement('div');
				errDiv.className = 'p-4 bg-error/15 text-error rounded-2xl text-xs border border-error/30';
				errDiv.textContent = `Encountered an issue executing deal instruction: ${err.message}`;
				chatStream?.appendChild(errDiv);
			} finally {
				if (sendBtn) {
					sendBtn.removeAttribute('disabled');
					sendBtn.innerHTML = 'Plan ⏎';
				}
			}
		}

		// Chat Form Submission
		chatForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (chatInput) submitPrompt(chatInput.value);
		});

		// Reset Session (Clears frontend state and SQLite store)
		resetBtn?.addEventListener('click', async () => {
			dealContext = {};
			storedArtifacts = {};
			conversationHistory = [];
			try {
				await fetch('/api/reset', { method: 'POST' });
			} catch (e) {
				console.warn('Could not reset server artifacts:', e);
			}
			if (chatStream) {
				chatStream.innerHTML = '';
				if (welcomeTurn) chatStream.appendChild(welcomeTurn);
				welcomeTurn?.classList.remove('hidden');
			}
			if (dealTitleBadge) dealTitleBadge.textContent = 'New Opportunity';
			if (dealStageBadge) dealStageBadge.classList.add('hidden');
			if (dealHealthBadge) dealHealthBadge.classList.add('hidden');
			updateSideBadges();
			setSidePanelState(false);
		});

		// Load existing SQLite artifacts on page mount
		async function loadInitialArtifacts() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) return;
				const list = await res.json();
				if (Array.isArray(list) && list.length > 0) {
					const latestByType: Record<string, any> = {};
					for (const art of list) {
						if (art.type && !latestByType[art.type]) {
							latestByType[art.type] = art;
						}
					}
					storedArtifacts = { ...storedArtifacts, ...latestByType };

					const mostRecent = list[0];
					if (mostRecent && mostRecent.deal_context && (!dealContext || !dealContext.account_name)) {
						dealContext = { ...dealContext, ...mostRecent.deal_context };
						if (dealTitleBadge && dealContext.account_name) {
							dealTitleBadge.textContent = `${dealContext.account_name} (${dealContext.deal_size || ''})`;
						}
						if (dealStageBadge && (dealContext.deal_stage || dealContext.stage)) {
							dealStageBadge.textContent = dealContext.deal_stage || dealContext.stage;
							dealStageBadge.classList.remove('hidden');
						}
						if (dealHealthBadge && (dealContext.health_status || dealContext.health)) {
							const health = dealContext.health_status || dealContext.health;
							dealHealthBadge.textContent = health;
							dealHealthBadge.classList.remove('hidden');
							dealHealthBadge.className = 'badge badge-xs font-mono font-semibold ';
							if (health.toLowerCase().includes('risk')) {
								dealHealthBadge.className += 'badge-error text-white';
							} else if (health.toLowerCase().includes('strong') || health.toLowerCase().includes('healthy')) {
								dealHealthBadge.className += 'badge-success text-white';
							} else {
								dealHealthBadge.className += 'badge-warning';
							}
						}
					}
					updateSideBadges();
				}
			} catch (e) {
				console.warn('Could not load initial artifacts:', e);
			}
		}

		// Grounding Sources Logic
		const btnOpenAttachModal = document.getElementById('btn-open-attach-modal');
		const attachSourceModal = document.getElementById('attach-source-modal') as HTMLDialogElement;
		const modalSourceType = document.getElementById('modal-source-type') as HTMLSelectElement;
		const modalSourceUrl = document.getElementById('modal-source-url') as HTMLInputElement;
		const btnSubmitSource = document.getElementById('btn-submit-source');
		const activeSourcesList = document.getElementById('active-sources-list');

		btnOpenAttachModal?.addEventListener('click', () => {
			attachSourceModal?.showModal();
		});

		async function loadSources() {
			try {
				const res = await fetch('/api/sources');
				if (!res.ok) return;
				const sources = await res.json();
				renderActiveSources(sources);
			} catch (e) {
				console.warn('Could not load sources:', e);
			}
		}

		function renderActiveSources(sources: any[]) {
			if (!activeSourcesList) return;
			activeSourcesList.innerHTML = '';
			if (!Array.isArray(sources) || sources.length === 0) return;

			sources.forEach((s) => {
				const c = s.content || {};
				const badge = document.createElement('div');
				badge.className = 'badge badge-xs badge-success gap-1 font-mono text-[10px] py-1 px-2 shadow-2xs select-none max-w-[200px] truncate flex items-center shrink-0';
				const icon = s.source_type === 'github' ? '🐙' : s.source_type === 'pdf' ? '📄' : '🌐';
				badge.innerHTML = `
					<span class="shrink-0">${icon}</span>
					<span class="font-bold truncate max-w-[120px] inline-block">${c.title || c.url_or_path}</span>
					<span class="text-success-content/80 shrink-0">✓</span>
					<button type="button" class="btn-remove-source ml-0.5 hover:text-error cursor-pointer font-bold px-0.5 shrink-0" data-id="${s.id || c.url_or_path}" title="Remove source">✕</button>
				`;
				activeSourcesList.appendChild(badge);
			});

			activeSourcesList.querySelectorAll('.btn-remove-source').forEach((btn) => {
				btn.addEventListener('click', async (e) => {
					e.stopPropagation();
					const sid = btn.getAttribute('data-id');
					if (sid) {
						try {
							await fetch('/api/sources/' + encodeURIComponent(sid), { method: 'DELETE' });
							await loadSources();
						} catch (err) {
							console.warn('Failed to delete source:', err);
						}
					}
				});
			});
		}

		btnSubmitSource?.addEventListener('click', async () => {
			const type = modalSourceType?.value || 'github';
			const url = modalSourceUrl?.value.trim() || '';
			if (!url) return;

			if (btnSubmitSource) {
				btnSubmitSource.setAttribute('disabled', 'true');
				btnSubmitSource.textContent = 'Verifying...';
			}

			try {
				const res = await fetch('/api/sources/ingest', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ source_type: type, url_or_path: url }),
				});
				if (res.ok) {
					modalSourceUrl.value = '';
					attachSourceModal?.close();
					await loadSources();
				}
			} catch (e) {
				console.error(e);
			} finally {
				if (btnSubmitSource) {
					btnSubmitSource.removeAttribute('disabled');
					btnSubmitSource.textContent = 'Verify & Attach ↗';
				}
			}
		});

		// Initialize
		updateSideBadges();
		loadInitialArtifacts();
		loadSources();
	</script>
</Layout>
