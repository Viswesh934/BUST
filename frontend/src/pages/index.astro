---
import Layout from '../layouts/Layout.astro';
import ChatWindow from '../components/ChatWindow.astro';
import SidePanel from '../components/SidePanel.astro';
import AppDock from '../components/AppDock.astro';
---

<Layout title="BUST — Plan" description="AI Deal Planning & Execution" fullHeight={true}>
	<div class="relative flex flex-1 w-full h-full min-h-0 overflow-hidden">
		<!-- 1. LEFT BALANCE SPACER: Matches right dock (w-12) to ensure optical centering -->
		<div class="w-12 shrink-0 hidden md:block select-none pointer-events-none"></div>

		<!-- 2. CENTER: EXPANSIVE PLANNER CHAT WINDOW -->
		<ChatWindow />

		<!-- 3. FLOATING SLIDE-OVER DELIVERABLES PANEL -->
		<SidePanel />

		<!-- 4. STICKY VERTICAL APP ICONS DOCK -->
		<AppDock />
	</div>

	<!-- 3D FLIP CARD & CAROUSEL UTILITY STYLES -->
	<style is:global>
		.perspective-1000 {
			perspective: 1000px;
		}
		.flip-card {
			perspective: 1000px;
		}
		.flip-card-inner {
			position: relative;
			width: 100%;
			height: 100%;
			transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
			transform-style: preserve-3d;
		}
		.flip-card-inner.is-flipped {
			transform: rotateY(180deg);
		}
		.backface-hidden {
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
		}
		.rotate-y-180 {
			transform: rotateY(180deg);
		}
	</style>

	<script>
		import { renderMarkdown } from '../utils/markdown';
		import { renderCompetitorView } from '../components/deliverables/competitor';
		import { renderBattlecardsView } from '../components/deliverables/battlecards';
		import { renderPresentationView } from '../components/deliverables/presentation';
		import { renderEmailView } from '../components/deliverables/email';
		import { renderFlowchartView } from '../components/deliverables/flowchart';
		import { renderSocialView } from '../components/deliverables/social';
		import { renderSuiteView } from '../components/deliverables/suite';

		let dealContext: any = {};
		let storedArtifacts: any = {};
		let activeTab: string = 'battlecards';
		let sidePanelOpen: boolean = false;
		let conversationHistory: Array<{ role: string; content: string }> = [];

		// Chat DOM elements
		const chatStream = document.getElementById('chat-stream');
		const chatForm = document.getElementById('chat-form');
		const chatInput = document.getElementById('chat-input') as HTMLInputElement;
		const sendBtn = document.getElementById('btn-send-directive');
		const resetBtn = document.getElementById('btn-reset-session');
		const welcomeTurn = document.getElementById('welcome-turn');
		const dealTitleBadge = document.getElementById('deal-title-badge');
		const dealStageBadge = document.getElementById('deal-stage-badge');
		const dealHealthBadge = document.getElementById('deal-health-badge');

		// Side Panel DOM elements
		const sidePanel = document.getElementById('side-panel');
		const btnCloseSide = document.getElementById('btn-close-side');
		const sidePanelTitle = document.getElementById('side-panel-title');
		const sideActiveAccount = document.getElementById('side-active-account');
		const btnOpenFullPage = document.getElementById('btn-open-full-page') as HTMLAnchorElement;
		const fullPageBtnText = document.getElementById('full-page-btn-text');
		const sideEmptyState = document.getElementById('side-empty-state');
		const sideDeliverableView = document.getElementById('side-deliverable-view');

		// App Dock DOM elements
		const sideAppBtns = document.querySelectorAll('.side-app-btn');
		const appDockToggle = document.getElementById('app-dock-toggle');
		const appDockToggleIcon = document.getElementById('app-dock-toggle-icon');
		const appBadgeBc = document.getElementById('app-badge-bc');
		const appBadgeComp = document.getElementById('app-badge-comp');
		const appBadgeDeck = document.getElementById('app-badge-deck');
		const appBadgeEmail = document.getElementById('app-badge-email');
		const appBadgeMap = document.getElementById('app-badge-map');
		const appBadgeSocial = document.getElementById('app-badge-social');
		const appBadgeSuite = document.getElementById('app-badge-suite');

		// Side Panel Open/Close Transition
		function setSidePanelState(open: boolean) {
			sidePanelOpen = open;
			if (!sidePanel) return;

			if (open) {
				sidePanel.classList.remove('translate-x-[110%]', 'opacity-0', 'pointer-events-none');
				sidePanel.classList.add('translate-x-0', 'opacity-100', 'pointer-events-auto');
				if (appDockToggleIcon) appDockToggleIcon.textContent = '▶';
				renderActiveDeliverable();
			} else {
				sidePanel.classList.remove('translate-x-0', 'opacity-100', 'pointer-events-auto');
				sidePanel.classList.add('translate-x-[110%]', 'opacity-0', 'pointer-events-none');
				if (appDockToggleIcon) appDockToggleIcon.textContent = '◀';
				sideAppBtns.forEach((b) => b.classList.remove('ring-2', 'ring-primary', 'bg-base-200'));
			}
		}

		appDockToggle?.addEventListener('click', () => {
			setSidePanelState(!sidePanelOpen);
		});

		btnCloseSide?.addEventListener('click', () => {
			setSidePanelState(false);
		});

		// Switch Active App Tab
		function switchAppTab(tabKey: string) {
			if (sidePanelOpen && activeTab === tabKey) {
				setSidePanelState(false);
				return;
			}

			activeTab = tabKey;
			sideAppBtns.forEach((btn) => {
				const key = btn.getAttribute('data-tab');
				if (key === tabKey) {
					btn.classList.add('ring-2', 'ring-primary', 'bg-base-200');
				} else {
					btn.classList.remove('ring-2', 'ring-primary', 'bg-base-200');
				}
			});

			if (!sidePanelOpen) {
				setSidePanelState(true);
			} else {
				renderActiveDeliverable();
			}
		}

		sideAppBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const key = btn.getAttribute('data-tab') || 'battlecards';
				switchAppTab(key);
			});
		});

		// Render Active Deliverable
		function renderActiveDeliverable() {
			if (!sideDeliverableView) return;

			const titles: Record<string, string> = {
				battlecards: '🎴 Objection Battlecards',
				competitor: '🎯 Competitor Intelligence',
				presentation: '📊 Pitch Presentation Deck',
				email: '✉️ Executive Proposal Email',
				flowchart: '🗺️ Mutual Action Plan (MAP)',
				social: '🐦 Executive Social Touchpoint (X / LinkedIn)',
				suite: '🏨 Buyer Deal Room Suite'
			};

			if (sidePanelTitle) {
				sidePanelTitle.textContent = titles[activeTab] || 'Deliverables Preview';
			}

			// Update Redirection Target & Text
			if (btnOpenFullPage && fullPageBtnText) {
				if (activeTab === 'battlecards') {
					btnOpenFullPage.href = '/battlecards';
					fullPageBtnText.textContent = 'Open Full Deck ↗';
				} else if (activeTab === 'competitor') {
					btnOpenFullPage.href = '/competitor';
					fullPageBtnText.textContent = 'Open Full Teardown ↗';
				} else if (activeTab === 'presentation') {
					btnOpenFullPage.href = '/presentations';
					fullPageBtnText.textContent = 'Open 16:9 Studio ↗';
				} else if (activeTab === 'email') {
					btnOpenFullPage.href = '/emails';
					fullPageBtnText.textContent = 'Open Full Email ↗';
				} else if (activeTab === 'flowchart') {
					btnOpenFullPage.href = '/flowcharts';
					fullPageBtnText.textContent = 'Open Full MAP ↗';
				} else if (activeTab === 'social') {
					btnOpenFullPage.href = '#';
					fullPageBtnText.textContent = 'Social Hook 🐦';
				} else if (activeTab === 'suite') {
					const shareId = storedArtifacts.suite?.share_id || 'suite_live';
					btnOpenFullPage.href = `/suite?id=${shareId}`;
					fullPageBtnText.textContent = 'Open Buyer Room ↗';
				}
			}

			const art = storedArtifacts[activeTab];

			if (!art) {
				if (sideEmptyState) {
					sideEmptyState.classList.remove('hidden');
					const emptyTitle = document.getElementById('side-empty-title');
					const emptyDesc = document.getElementById('side-empty-desc');
					if (emptyTitle) emptyTitle.textContent = `No ${titles[activeTab] || 'Deliverables'} Generated Yet`;
					if (emptyDesc) emptyDesc.textContent = `Prompt the agent in the chat to synthesize ${titles[activeTab] || 'deliverables'} for this opportunity.`;
				}
				sideDeliverableView.classList.add('hidden');
				return;
			}

			if (sideEmptyState) sideEmptyState.classList.add('hidden');
			sideDeliverableView.classList.remove('hidden');

			if (sideActiveAccount) {
				sideActiveAccount.textContent = dealContext.account_name || 'Active Deal';
			}

			// Dispatch to modular deliverable renderers
			if (activeTab === 'battlecards') {
				renderBattlecardsView(sideDeliverableView, art);
			} else if (activeTab === 'competitor') {
				renderCompetitorView(sideDeliverableView, art, dealContext, handleCrustdataRefresh);
			} else if (activeTab === 'presentation') {
				renderPresentationView(sideDeliverableView, art);
			} else if (activeTab === 'email') {
				renderEmailView(sideDeliverableView, art);
			} else if (activeTab === 'flowchart') {
				renderFlowchartView(sideDeliverableView, art);
			} else if (activeTab === 'social') {
				renderSocialView(sideDeliverableView, art, dealContext);
			} else if (activeTab === 'suite') {
				renderSuiteView(sideDeliverableView, art, dealContext);
			}
		}

		// Crustdata Live Refresh Handler
		async function handleCrustdataRefresh(): Promise<void> {
			const comp = storedArtifacts.competitor?.content || {};
			const res = await fetch('/api/competitor/deep-research', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					competitor: comp.competitor_name || dealContext.competitor || 'Competitor',
					account_name: dealContext.account_name || 'Enterprise',
				}),
			});
			if (res.ok) {
				const data = await res.json();
				if (data.artifact?.content) {
					if (!storedArtifacts.competitor.content) storedArtifacts.competitor.content = {};
					storedArtifacts.competitor.content.crustdata_research = data.artifact.content;
					renderActiveDeliverable();
				}
			}
		}

		// Update Dock Badges
		function updateSideBadges() {
			const bc = storedArtifacts.battlecards?.content?.cards?.length || 0;
			if (appBadgeBc) {
				appBadgeBc.textContent = bc.toString();
				if (bc > 0) appBadgeBc.classList.remove('hidden');
				else appBadgeBc.classList.add('hidden');
			}

			const comp = storedArtifacts.competitor ? 1 : 0;
			if (appBadgeComp) {
				appBadgeComp.textContent = comp.toString();
				if (comp > 0) appBadgeComp.classList.remove('hidden');
				else appBadgeComp.classList.add('hidden');
			}

			const deck = storedArtifacts.presentation?.content?.slides?.length || 0;
			if (appBadgeDeck) {
				appBadgeDeck.textContent = deck.toString();
				if (deck > 0) appBadgeDeck.classList.remove('hidden');
				else appBadgeDeck.classList.add('hidden');
			}

			const email = storedArtifacts.email ? 1 : 0;
			if (appBadgeEmail) {
				appBadgeEmail.textContent = email.toString();
				if (email > 0) appBadgeEmail.classList.remove('hidden');
				else appBadgeEmail.classList.add('hidden');
			}

			const map = storedArtifacts.flowchart?.content?.stages?.length || 0;
			if (appBadgeMap) {
				appBadgeMap.textContent = map.toString();
				if (map > 0) appBadgeMap.classList.remove('hidden');
				else appBadgeMap.classList.add('hidden');
			}

			const social = storedArtifacts.social ? 1 : 0;
			if (appBadgeSocial) {
				appBadgeSocial.textContent = social.toString();
				if (social > 0) appBadgeSocial.classList.remove('hidden');
				else appBadgeSocial.classList.add('hidden');
			}

			const suite = storedArtifacts.suite ? 1 : 0;
			if (appBadgeSuite) {
				appBadgeSuite.textContent = suite.toString();
				if (suite > 0) appBadgeSuite.classList.remove('hidden');
				else appBadgeSuite.classList.add('hidden');
			}
		}

		// Append User Message
		function appendUserMessage(text: string) {
			if (!chatStream) return;
			if (welcomeTurn) welcomeTurn.classList.add('hidden');

			const escaped = text
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');

			const turnDiv = document.createElement('div');
			turnDiv.className = 'flex justify-end';
			turnDiv.innerHTML = `
				<div class="p-3.5 sm:p-4 bg-neutral text-neutral-content rounded-2xl text-xs sm:text-sm font-medium leading-relaxed max-w-[85%] shadow-xs break-words whitespace-pre-wrap">
					${escaped}
				</div>
			`;
			chatStream.appendChild(turnDiv);
			chatStream.scrollTop = chatStream.scrollHeight;
		}

		// Append Progress Block
		function appendProgressBlock(): HTMLDivElement | null {
			if (!chatStream) return null;
			const progDiv = document.createElement('div');
			progDiv.className = 'p-4 bg-base-200/80 rounded-2xl border border-base-300 animate-pulse text-xs max-w-xl space-y-2';
			progDiv.innerHTML = `
				<div class="flex items-center gap-2 font-bold text-base-content">
					<span class="loading loading-spinner loading-xs text-primary"></span>
					<span>Analyzing deal directives & formulating plan...</span>
				</div>
				<div class="font-mono text-[11px] text-base-content/70 space-y-0.5">
					<div>● Evaluating competitive context & ROI requirements...</div>
					<div>● Dispatching deterministic tools to DAG engine...</div>
				</div>
			`;
			chatStream.appendChild(progDiv);
			chatStream.scrollTop = chatStream.scrollHeight;
			return progDiv;
		}

		// Append Agent Response with Markdown & Action Pills
		function appendAgentTurn(data: any) {
			if (!chatStream) return;
			const turnDiv = document.createElement('div');
			turnDiv.className = 'space-y-3.5 w-full min-w-0';

			if (data.agent_reply) {
				conversationHistory.push({ role: 'assistant', content: data.agent_reply });
			}

			// Update Deal Context & Badges
			if (data.deal_context) {
				dealContext = { ...dealContext, ...data.deal_context };
				if (dealTitleBadge) {
					dealTitleBadge.textContent = `${dealContext.account_name || 'Opportunity'} (${dealContext.deal_size || ''})`;
				}
				if (dealStageBadge) {
					const stage = dealContext.deal_stage || dealContext.stage;
					if (stage) {
						dealStageBadge.textContent = stage;
						dealStageBadge.classList.remove('hidden');
					}
				}
				if (dealHealthBadge) {
					const health = dealContext.health_status || dealContext.health;
					if (health) {
						dealHealthBadge.textContent = health;
						dealHealthBadge.classList.remove('hidden');
						dealHealthBadge.className = 'badge badge-xs font-mono font-semibold ';
						if (health.toLowerCase().includes('risk')) {
							dealHealthBadge.className += 'badge-error text-white';
						} else if (health.toLowerCase().includes('strong') || health.toLowerCase().includes('healthy')) {
							dealHealthBadge.className += 'badge-success text-white';
						} else {
							dealHealthBadge.className += 'badge-warning';
						}
					}
				}
			}

			// Store new artifacts and switch to side view
			const arts = data.artifacts || {};
			const newKeys = Object.keys(arts);
			if (newKeys.length > 0) {
				storedArtifacts = { ...storedArtifacts, ...arts };
				updateSideBadges();
				setSidePanelState(true);
				switchAppTab(newKeys[0]);
			}

			// Tactical Decision Rationale Callout
			let rationaleHtml = '';
			if (data.decision_rationale) {
				rationaleHtml = `
					<div class="p-3 bg-base-200/90 rounded-xl border border-base-300 text-xs space-y-1.5 font-sans min-w-0 break-words">
						<div class="flex items-center justify-between text-[11px] font-bold text-base-content/80 uppercase tracking-wider gap-2">
							<span class="flex items-center gap-1.5 shrink-0">🧠 Tactical Decision Rationale</span>
							${data.primary_risk ? `<span class="text-error font-medium normal-case truncate">⚠️ Risk: ${data.primary_risk}</span>` : ''}
						</div>
						<div class="text-base-content/85 leading-relaxed markdown-content">${renderMarkdown(data.decision_rationale)}</div>
					</div>
				`;
			}

			// Generated deliverables pill banner
			let generatedPillsHtml = '';
			if (newKeys.length > 0) {
				generatedPillsHtml = `
					<div class="flex flex-wrap items-center gap-1.5 pt-1">
						<span class="text-[11px] font-semibold text-base-content/70">Generated Deliverables:</span>
						${newKeys.map((k) => {
							const labels: Record<string, string> = {
								battlecards: '🎴 Battlecards',
								competitor: '🎯 Competitor Intelligence',
								presentation: '📊 Pitch Deck',
								email: '✉️ Proposal Email',
								flowchart: '🗺️ Mutual Action Plan',
								social: '🐦 Social Touchpoint',
								suite: '🏨 Deal Suite'
							};
							return `
								<button class="side-inspect-pill btn btn-xs btn-neutral gap-1 cursor-pointer" data-tab="${k}">
									<span>${labels[k] || k}</span>
									<span>→</span>
								</button>
							`;
						}).join('')}
					</div>
				`;
			}

			// Follow-up Suggestions
			const followUps = data.follow_ups || [];
			let followUpsHtml = '';
			if (followUps.length > 0) {
				followUpsHtml = `
					<div class="mt-3 pt-3 border-t border-base-200/80 space-y-2">
						<div class="flex items-center gap-1.5 text-[11px] font-semibold text-base-content/75">
							<span>💡 Recommended Next Deliverables:</span>
						</div>
						<div class="flex flex-wrap gap-1.5">
							${followUps.map((fu: any) => `
								<button class="followup-chip btn btn-xs btn-outline rounded-full font-medium text-[11px] transition-all hover:btn-neutral cursor-pointer" data-prompt="${fu.prompt}">
									${fu.label}
								</button>
							`).join('')}
						</div>
					</div>
				`;
			}

			turnDiv.innerHTML = `
				<div class="card bg-base-100 border border-base-200/90 p-4 sm:p-5 rounded-2xl shadow-xs space-y-3 min-w-0 break-words overflow-hidden">
					<div class="text-xs sm:text-sm text-base-content leading-relaxed font-medium markdown-content min-w-0 break-words">
						${renderMarkdown(data.agent_reply || 'Plan executed.')}
					</div>
					${rationaleHtml}
					${generatedPillsHtml}
					${followUpsHtml}
				</div>
			`;

			chatStream.appendChild(turnDiv);
			chatStream.scrollTop = chatStream.scrollHeight;

			// Attach listener to pills
			turnDiv.querySelectorAll('.side-inspect-pill').forEach((pill) => {
				pill.addEventListener('click', () => {
					const tabKey = pill.getAttribute('data-tab') || 'battlecards';
					switchAppTab(tabKey);
				});
			});

			// Attach listener to follow-up suggestion chips
			turnDiv.querySelectorAll('.followup-chip').forEach((chip) => {
				chip.addEventListener('click', () => {
					const prompt = chip.getAttribute('data-prompt');
					if (prompt) submitPrompt(prompt);
				});
			});
		}

		// Core Submit Prompt
		async function submitPrompt(promptText: string) {
			const text = promptText.trim();
			if (!text) return;

			if (chatInput) chatInput.value = '';
			appendUserMessage(text);
			conversationHistory.push({ role: 'user', content: text });
			const progBlock = appendProgressBlock();

			if (sendBtn) {
				sendBtn.setAttribute('disabled', 'true');
				sendBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';
			}

			try {
				const res = await fetch('/api/agent/run', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						message: text,
						deal_context: dealContext,
						history: conversationHistory.slice(-8),
					}),
				});

				if (!res.ok) throw new Error(`HTTP error ${res.status}`);
				const data = await res.json();
				if (progBlock) progBlock.remove();
				appendAgentTurn(data);
			} catch (err: any) {
				if (progBlock) progBlock.remove();
				const errDiv = document.createElement('div');
				errDiv.className = 'p-4 bg-error/15 text-error rounded-2xl text-xs border border-error/30';
				errDiv.textContent = `Encountered an issue executing deal instruction: ${err.message}`;
				chatStream?.appendChild(errDiv);
			} finally {
				if (sendBtn) {
					sendBtn.removeAttribute('disabled');
					sendBtn.innerHTML = 'Plan ⏎';
				}
			}
		}

		// Chat Form Submission
		chatForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (chatInput) submitPrompt(chatInput.value);
		});

		// Reset Session
		resetBtn?.addEventListener('click', async () => {
			dealContext = {};
			storedArtifacts = {};
			conversationHistory = [];
			try {
				await fetch('/api/reset', { method: 'POST' });
			} catch (e) {
				console.warn('Could not reset server artifacts:', e);
			}
			if (chatStream) {
				chatStream.innerHTML = '';
				if (welcomeTurn) chatStream.appendChild(welcomeTurn);
				welcomeTurn?.classList.remove('hidden');
			}
			if (dealTitleBadge) dealTitleBadge.textContent = 'New Opportunity';
			if (dealStageBadge) dealStageBadge.classList.add('hidden');
			if (dealHealthBadge) dealHealthBadge.classList.add('hidden');
			updateSideBadges();
			setSidePanelState(false);
		});

		// Load existing SQLite artifacts on page mount
		async function loadInitialArtifacts() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) return;
				const list = await res.json();
				if (Array.isArray(list) && list.length > 0) {
					const latestByType: Record<string, any> = {};
					for (const art of list) {
						if (art.type && !latestByType[art.type]) {
							latestByType[art.type] = art;
						}
					}
					storedArtifacts = { ...storedArtifacts, ...latestByType };

					const mostRecent = list[0];
					if (mostRecent && mostRecent.deal_context && (!dealContext || !dealContext.account_name)) {
						dealContext = { ...dealContext, ...mostRecent.deal_context };
						if (dealTitleBadge && dealContext.account_name) {
							dealTitleBadge.textContent = `${dealContext.account_name} (${dealContext.deal_size || ''})`;
						}
						if (dealStageBadge && (dealContext.deal_stage || dealContext.stage)) {
							dealStageBadge.textContent = dealContext.deal_stage || dealContext.stage;
							dealStageBadge.classList.remove('hidden');
						}
						if (dealHealthBadge && (dealContext.health_status || dealContext.health)) {
							const health = dealContext.health_status || dealContext.health;
							dealHealthBadge.textContent = health;
							dealHealthBadge.classList.remove('hidden');
							dealHealthBadge.className = 'badge badge-xs font-mono font-semibold ';
							if (health.toLowerCase().includes('risk')) {
								dealHealthBadge.className += 'badge-error text-white';
							} else if (health.toLowerCase().includes('strong') || health.toLowerCase().includes('healthy')) {
								dealHealthBadge.className += 'badge-success text-white';
							} else {
								dealHealthBadge.className += 'badge-warning';
							}
						}
					}
					updateSideBadges();
				}
			} catch (e) {
				console.warn('Could not load initial artifacts:', e);
			}
		}

		// Attached Grounding Sources Management
		const btnOpenAttachModal = document.getElementById('btn-open-attach-modal');
		const attachSourceModal = document.getElementById('attach-source-modal') as HTMLDialogElement;
		const modalSourceType = document.getElementById('modal-source-type') as HTMLSelectElement;
		const modalSourceUrl = document.getElementById('modal-source-url') as HTMLInputElement;
		const btnSubmitSource = document.getElementById('btn-submit-source');
		const activeSourcesList = document.getElementById('active-sources-list');

		btnOpenAttachModal?.addEventListener('click', () => {
			attachSourceModal?.showModal();
		});

		async function loadSources() {
			try {
				const res = await fetch('/api/sources');
				if (!res.ok) return;
				const sources = await res.json();
				renderActiveSources(sources);
			} catch (e) {
				console.warn('Could not load sources:', e);
			}
		}

		function renderActiveSources(sources: any[]) {
			if (!activeSourcesList) return;
			activeSourcesList.innerHTML = '';
			if (!Array.isArray(sources) || sources.length === 0) return;

			sources.forEach((s) => {
				const c = s.content || {};
				const badge = document.createElement('div');
				badge.className = 'badge badge-xs badge-success gap-1 font-mono text-[10px] py-1 px-2 shadow-2xs select-none max-w-[200px] truncate flex items-center shrink-0';
				const icon = s.source_type === 'github' ? '🐙' : s.source_type === 'pdf' ? '📄' : '🌐';
				badge.innerHTML = `
					<span class="shrink-0">${icon}</span>
					<span class="font-bold truncate max-w-[120px] inline-block">${c.title || c.url_or_path}</span>
					<span class="text-success-content/80 shrink-0">✓</span>
					<button type="button" class="btn-remove-source ml-0.5 hover:text-error cursor-pointer font-bold px-0.5 shrink-0" data-id="${s.id || c.url_or_path}" title="Remove source">✕</button>
				`;
				activeSourcesList.appendChild(badge);
			});

			activeSourcesList.querySelectorAll('.btn-remove-source').forEach((btn) => {
				btn.addEventListener('click', async (e) => {
					e.stopPropagation();
					const sid = btn.getAttribute('data-id');
					if (sid) {
						try {
							await fetch('/api/sources/' + encodeURIComponent(sid), { method: 'DELETE' });
							await loadSources();
						} catch (err) {
							console.warn('Failed to delete source:', err);
						}
					}
				});
			});
		}

		btnSubmitSource?.addEventListener('click', async () => {
			const type = modalSourceType?.value || 'github';
			const url = modalSourceUrl?.value.trim();
			if (!url) return;

			if (btnSubmitSource) {
				btnSubmitSource.setAttribute('disabled', 'true');
				btnSubmitSource.textContent = 'Verifying...';
			}

			try {
				const res = await fetch('/api/sources/ingest', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ source_type: type, url_or_path: url }),
				});
				if (res.ok) {
					if (modalSourceUrl) modalSourceUrl.value = '';
					attachSourceModal?.close();
					await loadSources();
				} else {
					alert('Could not verify source. Check repository or URL.');
				}
			} catch (err) {
				alert('Network error verifying source.');
			} finally {
				if (btnSubmitSource) {
					btnSubmitSource.removeAttribute('disabled');
					btnSubmitSource.textContent = 'Verify & Attach ↗';
				}
			}
		});

		modalSourceType?.addEventListener('change', () => {
			const lbl = document.getElementById('modal-url-label');
			if (!lbl) return;
			if (modalSourceType.value === 'github') {
				lbl.textContent = 'Repository URL / Name';
				modalSourceUrl.placeholder = 'e.g. https://github.com/my-org/core-engine';
			} else if (modalSourceType.value === 'website') {
				lbl.textContent = 'Documentation URL';
				modalSourceUrl.placeholder = 'e.g. https://docs.company.com/architecture';
			} else {
				lbl.textContent = 'PDF Path or Document URL';
				modalSourceUrl.placeholder = 'e.g. https://company.com/soc2-audit.pdf';
			}
		});

		// Initial Load
		loadInitialArtifacts();
		loadSources();
	</script>
</Layout>
