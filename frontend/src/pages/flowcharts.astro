---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mutual Action Plans" description="Deal Closing Roadmaps & Joint Execution Pipelines">
	<div class="space-y-6 w-full">
		<!-- Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Mutual Action Plans (MAP)</h1>
					<span class="badge badge-sm badge-neutral" id="map-counter-badge">Active Repository</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					6-stage mutual closing roadmaps aligned with buyer decision milestones, synthesized by the AI Sales Agent.
				</p>
			</div>
			<!-- Top-Right Actions -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<a href="/" class="btn btn-sm btn-neutral gap-1.5 font-semibold">
					<span>← Back to Plan</span>
				</a>
			</div>
		</div>

		<!-- LOADING STATE -->
		<div id="loading-state" class="py-16 text-center space-y-3">
			<span class="loading loading-spinner loading-md text-primary"></span>
			<p class="text-xs text-base-content/60 font-mono">Loading roadmaps from agent artifact store...</p>
		</div>

		<!-- EMPTY STATE (Zero mock data) -->
		<div id="empty-state" class="hidden py-16 flex flex-col items-center justify-center text-center space-y-4">
			<div class="w-16 h-16 rounded-2xl bg-base-200 border-2 border-base-300 flex items-center justify-center text-3xl shadow-xs">
				🗺️
			</div>
			<div class="max-w-md space-y-1.5">
				<h3 class="font-bold text-base text-base-content">No Mutual Action Plans Generated Yet</h3>
				<p class="text-xs text-base-content/75 leading-relaxed">
					Closing roadmaps are built dynamically from your deal timeline and stakeholders. Instruct the AI agent to map a mutual action plan for your opportunity.
				</p>
			</div>
			<a href="/" class="btn btn-sm btn-neutral font-semibold">
				Go to Plan ⚡
			</a>
		</div>

		<!-- REAL ROADMAPS CONTAINER (Populated dynamically) -->
		<div id="roadmaps-container" class="hidden space-y-8">
			<!-- Dynamically injected -->
		</div>
	</div>

	<script>
		const loadingState = document.getElementById('loading-state');
		const emptyState = document.getElementById('empty-state');
		const roadmapsContainer = document.getElementById('roadmaps-container');
		const counterBadge = document.getElementById('map-counter-badge');

		async function loadRoadmaps() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) throw new Error('Failed to fetch artifacts');
				const artifacts = await res.json();
				const mapArtifacts = artifacts.filter((a: any) => a.type === 'flowchart');

				if (loadingState) loadingState.classList.add('hidden');

				if (!mapArtifacts.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				if (roadmapsContainer) roadmapsContainer.classList.remove('hidden');
				if (counterBadge) counterBadge.textContent = `${mapArtifacts.length} Active Plans`;

				let html = '';
				mapArtifacts.forEach((art: any) => {
					const fc = art.content || {};
					const stages = fc.stages || [];
					html += `
						<div class="card bg-base-100 border-2 border-base-300 p-6 rounded-2xl shadow-sm space-y-5">
							<div class="flex items-center justify-between border-b border-base-200 pb-3">
								<div>
									<h3 class="font-bold text-base text-base-content">${art.title || 'Mutual Action Plan'}</h3>
									<span class="text-xs text-base-content/60 font-mono">Account: ${fc.account_name || art.deal_context?.account_name || 'Enterprise'}</span>
								</div>
								<span class="badge badge-xs badge-warning font-semibold">Target Close: ${fc.target_close_date || 'Month-End'}</span>
							</div>

							<div class="space-y-3">
								${stages
									.map((st: any) => {
										const isDone = st.status === 'completed';
										const isCurr = st.status === 'current';
										const badgeClass = isDone ? 'badge-success' : isCurr ? 'badge-warning' : 'badge-neutral';
										const badgeText = isDone ? 'Completed ✓' : isCurr ? 'Active Stage' : 'Upcoming';
										const borderClass = isCurr ? 'border-primary/50 bg-primary/5' : 'border-base-300 bg-base-200/60';

										return `
										<div class="p-4 rounded-xl border-2 ${borderClass} flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs transition-all">
											<div class="space-y-1">
												<div class="flex items-center gap-2">
													<span class="font-mono text-xs text-base-content/60 font-bold">0${st.stage_number}</span>
													<span class="font-bold text-sm text-base-content">${st.name}</span>
													<span class="badge badge-xs ${badgeClass} font-semibold">${badgeText}</span>
												</div>
												<p class="text-xs text-base-content/75">${st.description || ''}</p>
											</div>
											<div class="text-right sm:shrink-0 text-xs font-mono text-base-content/70">
												<div>Owner: ${st.owner || 'AE & Buyer'}</div>
												<div class="font-semibold text-base-content">${st.target_date || ''}</div>
											</div>
										</div>
									`;
									})
									.join('')}
							</div>
						</div>
					`;
				});

				if (roadmapsContainer) roadmapsContainer.innerHTML = html;
			} catch (err) {
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		loadRoadmaps();
	</script>
</Layout>
