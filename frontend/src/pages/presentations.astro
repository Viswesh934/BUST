---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pitch & ROI Decks" description="Executive Presentations & Widescreen Slide Briefings">
	<div class="space-y-6 w-full">
		<!-- Header Toolbar -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-base-300">
			<div>
				<div class="flex items-center gap-2.5">
					<h1 class="text-xl font-bold tracking-tight text-base-content">Pitch & ROI Decks</h1>
					<span class="badge badge-sm badge-neutral" id="deck-counter-badge">Active Repository</span>
				</div>
				<p class="text-xs text-base-content/80 mt-1">
					16:9 executive briefing presentations synthesized autonomously by the AI Sales Agent.
				</p>
			</div>
			<!-- Top-Right Actions -->
			<div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
				<a href="/" class="btn btn-sm btn-neutral gap-1.5 font-semibold">
					<span>← Back to Plan</span>
				</a>
			</div>
		</div>

		<!-- LOADING STATE -->
		<div id="loading-state" class="py-16 text-center space-y-3">
			<span class="loading loading-spinner loading-md text-primary"></span>
			<p class="text-xs text-base-content/60 font-mono">Loading presentations from agent artifact store...</p>
		</div>

		<!-- EMPTY STATE (Zero mock data) -->
		<div id="empty-state" class="hidden py-16 flex flex-col items-center justify-center text-center space-y-4">
			<div class="w-16 h-16 rounded-2xl bg-base-200 border-2 border-base-300 flex items-center justify-center text-3xl shadow-xs">
				📊
			</div>
			<div class="max-w-md space-y-1.5">
				<h3 class="font-bold text-base text-base-content">No Pitch Decks Generated Yet</h3>
				<p class="text-xs text-base-content/75 leading-relaxed">
					Executive presentations are generated dynamically from your deal directives. Instruct the AI agent to build a presentation for your active opportunity.
				</p>
			</div>
			<a href="/" class="btn btn-sm btn-neutral font-semibold">
				Go to Plan ⚡
			</a>
		</div>

		<!-- REAL DECKS CONTAINER (Populated dynamically) -->
		<div id="decks-container" class="hidden space-y-8">
			<!-- Dynamically injected -->
		</div>
	</div>

	<script>
		const loadingState = document.getElementById('loading-state');
		const emptyState = document.getElementById('empty-state');
		const decksContainer = document.getElementById('decks-container');
		const counterBadge = document.getElementById('deck-counter-badge');

		async function loadPresentations() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) throw new Error('Failed to fetch artifacts');
				const artifacts = await res.json();
				const deckArtifacts = artifacts.filter((a: any) => a.type === 'presentation');

				if (loadingState) loadingState.classList.add('hidden');

				if (!deckArtifacts.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				if (decksContainer) decksContainer.classList.remove('hidden');
				if (counterBadge) counterBadge.textContent = `${deckArtifacts.length} Active Decks`;

				let html = '';
				deckArtifacts.forEach((art: any) => {
					const slides = art.content?.slides || [];
					html += `
						<div class="card bg-base-100 border-2 border-base-300 p-6 rounded-2xl shadow-sm space-y-5">
							<div class="flex items-center justify-between border-b border-base-200 pb-3">
								<div>
									<h3 class="font-bold text-base text-base-content">${art.title || 'Executive Presentation'}</h3>
									<span class="text-xs text-base-content/60 font-mono">Account: ${art.deal_context?.account_name || 'Enterprise'} (${slides.length} Slides)</span>
								</div>
								<span class="badge badge-xs badge-success font-semibold">Ready</span>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								${slides
									.map(
										(s: any) => `
									<div class="p-5 bg-base-200/80 rounded-xl border border-base-300 space-y-3 flex flex-col justify-between">
										<div class="space-y-1.5">
											<div class="flex items-center justify-between">
												<span class="badge badge-xs badge-neutral font-semibold">${s.tag || `Slide ${s.slide_number}`}</span>
												<span class="text-[10px] font-mono text-base-content/50">#${s.slide_number}</span>
											</div>
											<h4 class="font-bold text-sm text-base-content">${s.title}</h4>
											${s.subtitle ? `<p class="text-xs text-base-content/75">${s.subtitle}</p>` : ''}
										</div>

										<ul class="text-xs text-base-content/90 list-disc list-inside space-y-1 font-medium">
											${(s.bullets || []).map((b: string) => `<li>${b}</li>`).join('')}
										</ul>

										${
											s.speaker_note
												? `
											<div class="p-2.5 bg-base-100 rounded-lg text-[11px] text-base-content/70 border border-base-300/80">
												<span class="font-semibold text-base-content">Speaker Note:</span> ${s.speaker_note}
											</div>
										`
												: ''
										}
									</div>
								`
									)
									.join('')}
							</div>
						</div>
					`;
				});

				if (decksContainer) decksContainer.innerHTML = html;
			} catch (err) {
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		loadPresentations();
	</script>
</Layout>
