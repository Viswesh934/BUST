---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pitch & ROI Decks — Presentation Mode" description="16:9 Widescreen Executive Slide Deck Studio" fullHeight={true}>
	<!-- REAL PPT APPLICATION INTERFACE -->
	<div class="flex flex-col h-full w-full min-h-0 overflow-hidden">
		
		<!-- TOP APPLICATION TOOLBAR -->
		<div class="h-13 border-b border-base-300 px-4 flex items-center justify-between bg-base-100 shrink-0 gap-3">
			<div class="flex items-center gap-3 min-w-0">
				<span class="text-xl">📊</span>
				<div class="min-w-0">
					<h1 class="text-sm font-bold text-base-content truncate" id="deck-main-title">
						Executive Presentation Deck
					</h1>
					<div class="flex items-center gap-2 text-[11px] text-base-content/60 font-mono">
						<span id="deck-account-badge">Account: Loading...</span>
						<span>•</span>
						<span id="deck-slide-count-badge">0 Slides</span>
					</div>
				</div>
			</div>

			<!-- PPT Controls -->
			<div class="flex items-center gap-2 shrink-0">
				<!-- Navigation shortcuts -->
				<div class="flex items-center bg-base-200/80 rounded-lg p-0.5 border border-base-300">
					<button id="btn-prev-slide" type="button" class="btn btn-xs btn-ghost px-2 font-mono" title="Previous Slide (←)">
						◀ Prev
					</button>
					<span class="px-2 text-xs font-mono font-bold text-base-content/75" id="slide-position-indicator">
						1 / 1
					</span>
					<button id="btn-next-slide" type="button" class="btn btn-xs btn-ghost px-2 font-mono" title="Next Slide (→)">
						Next ▶
					</button>
				</div>

				<!-- Present Fullscreen -->
				<button id="btn-fullscreen" type="button" class="btn btn-xs btn-outline gap-1" title="Toggle Fullscreen (F)">
					<span>🖥️ Present</span>
				</button>

				<!-- Real PPT Download -->
				<button id="btn-download-ppt" type="button" class="btn btn-xs btn-neutral gap-1.5 font-semibold" title="Download standalone presentation deck">
					<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
					<span>Download Deck</span>
				</button>

				<!-- Back to Plan -->
				<a href="/" class="btn btn-xs btn-ghost text-base-content/70 hover:text-base-content">
					← Plan
				</a>
			</div>
		</div>

		<!-- LOADING STATE -->
		<div id="loading-state" class="flex-1 flex flex-col items-center justify-center p-8 space-y-3">
			<span class="loading loading-spinner loading-lg text-primary"></span>
			<p class="text-xs text-base-content/60 font-mono">Loading presentation deck from artifact store...</p>
		</div>

		<!-- EMPTY STATE (No dummy data) -->
		<div id="empty-state" class="hidden flex-1 flex flex-col items-center justify-center p-8 space-y-4 text-center">
			<div class="w-16 h-16 rounded-2xl bg-base-200 border-2 border-base-300 flex items-center justify-center text-3xl shadow-xs">
				📊
			</div>
			<div class="max-w-md space-y-1.5">
				<h3 class="font-bold text-base text-base-content">No Pitch Decks Generated Yet</h3>
				<p class="text-xs text-base-content/75 leading-relaxed">
					Presentations are synthesized dynamically by the AI Sales Agent from your active deal directives. Return to Plan to formulate a pitch deck for your opportunity.
				</p>
			</div>
			<a href="/" class="btn btn-sm btn-neutral font-semibold">
				Open Plan Workspace ⚡
			</a>
		</div>

		<!-- REAL PPT WORKSPACE (Left Filmstrip + Right 16:9 Main Stage) -->
		<div id="ppt-workspace" class="hidden flex-1 min-h-0 flex flex-row overflow-hidden bg-base-200/40">
			
			<!-- 1. LEFT FILMSTRIP (Slide Thumbnails) -->
			<div class="w-64 sm:w-72 border-r border-base-300 bg-base-100 flex flex-col shrink-0 min-h-0">
				<div class="p-3 border-b border-base-200 flex items-center justify-between text-xs font-bold text-base-content/70 uppercase tracking-wider shrink-0">
					<span>Slides Filmstrip</span>
					<span class="badge badge-xs badge-neutral font-mono" id="filmstrip-count">0</span>
				</div>
				<div class="flex-1 overflow-y-auto p-3 space-y-3" id="filmstrip-container">
					<!-- Thumbnails injected via JS -->
				</div>
			</div>

			<!-- 2. RIGHT / CENTER MAIN PRESENTATION STAGE -->
			<div class="flex-1 min-h-0 flex flex-col p-4 sm:p-6 overflow-y-auto items-center justify-center relative">
				
				<!-- 16:9 Widescreen Presentation Canvas -->
				<div id="slide-stage" class="w-full max-w-4xl aspect-[16/9] bg-base-100 rounded-2xl border-2 border-base-300 shadow-2xl p-6 sm:p-10 flex flex-col justify-between transition-all duration-300 select-none relative overflow-hidden">
					
					<!-- Top Slide Watermark & Header -->
					<div class="flex items-center justify-between border-b border-base-200/90 pb-3">
						<div class="flex items-center gap-2">
							<span class="badge badge-sm badge-neutral font-bold tracking-wider uppercase text-[10px]" id="current-slide-tag">
								EXECUTIVE SUMMARY
							</span>
							<span class="text-[10px] font-mono text-base-content/50 uppercase tracking-wider">
								CONFIDENTIAL BRIEFING
							</span>
						</div>
						<div class="flex items-center gap-2">
							<div class="badge badge-xs badge-success gap-1 font-mono text-[10px] py-1 px-2 shadow-2xs" id="current-slide-source-badge">
								<span class="opacity-75">Source:</span>
								<span id="current-slide-source-text" class="font-bold">github.com/bust-ai/core</span>
								<span>✓</span>
							</div>
							<div class="text-[11px] font-mono text-base-content/60 font-semibold" id="current-slide-index-badge">
								SLIDE 01
							</div>
						</div>
					</div>

					<!-- Center Slide Content -->
					<div class="my-auto space-y-4 sm:space-y-6">
						<div class="space-y-1.5">
							<h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-base-content tracking-tight leading-snug" id="current-slide-title">
								Slide Title
							</h2>
							<p class="text-xs sm:text-sm text-base-content/75 font-medium leading-relaxed" id="current-slide-subtitle">
								Slide Subtitle / Executive Takeaway
							</p>
						</div>

						<!-- Bullets Container -->
						<div class="grid grid-cols-1 gap-2.5 sm:gap-3" id="current-slide-bullets">
							<!-- Injected via JS -->
						</div>
					</div>

					<!-- Bottom Slide Footer -->
					<div class="pt-3 border-t border-base-200/90 flex items-center justify-between text-[10px] sm:text-[11px] text-base-content/60 font-mono">
						<span id="current-slide-footer-account">Enterprise Partnership</span>
						<span>BUST Revenue Intelligence</span>
						<span id="current-slide-footer-page">Page 1</span>
					</div>

				</div>

				<!-- SPEAKER NOTES DRAWER (Collapsible) -->
				<div class="w-full max-w-4xl mt-3 bg-base-100 border border-base-300 rounded-xl p-3 shadow-xs">
					<div class="flex items-center justify-between text-xs cursor-pointer select-none" id="toggle-notes-bar">
						<div class="flex items-center gap-2 font-bold text-base-content">
							<span>🎙️ AE Speaker Notes</span>
							<span class="badge badge-xs badge-ghost text-[10px]">Private Talk-Track</span>
						</div>
						<span class="text-base-content/60 text-xs" id="notes-chevron">▼</span>
					</div>
					<div class="mt-2 text-xs text-base-content/85 leading-relaxed font-sans bg-base-200/50 p-2.5 rounded-lg border border-base-300/60 font-medium" id="current-speaker-notes">
						No speaker notes recorded for this slide.
					</div>
				</div>

			</div>

		</div>

	</div>

	<script>
		let activeDeck: any = null;
		let slidesList: any[] = [];
		let currentSlideIndex: number = 0;
		let notesOpen: boolean = true;

		const loadingState = document.getElementById('loading-state');
		const emptyState = document.getElementById('empty-state');
		const pptWorkspace = document.getElementById('ppt-workspace');

		// Header elements
		const deckMainTitle = document.getElementById('deck-main-title');
		const deckAccountBadge = document.getElementById('deck-account-badge');
		const deckSlideCountBadge = document.getElementById('deck-slide-count-badge');
		const slidePosIndicator = document.getElementById('slide-position-indicator');
		const filmstripCount = document.getElementById('filmstrip-count');
		const filmstripContainer = document.getElementById('filmstrip-container');

		// Main stage elements
		const slideStage = document.getElementById('slide-stage');
		const currentSlideTag = document.getElementById('current-slide-tag');
		const currentSlideIndexBadge = document.getElementById('current-slide-index-badge');
		const currentSlideTitle = document.getElementById('current-slide-title');
		const currentSlideSubtitle = document.getElementById('current-slide-subtitle');
		const currentSlideBullets = document.getElementById('current-slide-bullets');
		const currentSlideFooterAccount = document.getElementById('current-slide-footer-account');
		const currentSlideFooterPage = document.getElementById('current-slide-footer-page');
		const currentSpeakerNotes = document.getElementById('current-speaker-notes');

		// Buttons
		const btnPrev = document.getElementById('btn-prev-slide');
		const btnNext = document.getElementById('btn-next-slide');
		const btnFullscreen = document.getElementById('btn-fullscreen');
		const btnDownload = document.getElementById('btn-download-ppt');
		const toggleNotesBar = document.getElementById('toggle-notes-bar');
		const notesChevron = document.getElementById('notes-chevron');

		// Fetch real presentations from SQLite store
		async function loadPresentation() {
			try {
				const res = await fetch('/api/artifacts');
				if (!res.ok) throw new Error('Failed to load artifacts');
				const all = await res.json();
				const decks = all.filter((a: any) => a.type === 'presentation');

				if (loadingState) loadingState.classList.add('hidden');

				if (!decks.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				// Pick most recent deck
				activeDeck = decks[0];
				slidesList = activeDeck.content?.slides || [];

				if (!slidesList.length) {
					if (emptyState) emptyState.classList.remove('hidden');
					return;
				}

				if (pptWorkspace) pptWorkspace.classList.remove('hidden');

				// Setup Header
				const accountName = activeDeck.deal_context?.account_name || activeDeck.content?.account_name || 'Enterprise';
				if (deckMainTitle) deckMainTitle.textContent = activeDeck.title || `${accountName} — Commercial Pitch Deck`;
				if (deckAccountBadge) deckAccountBadge.textContent = `Account: ${accountName}`;
				if (deckSlideCountBadge) deckSlideCountBadge.textContent = `${slidesList.length} Slides`;
				if (filmstripCount) filmstripCount.textContent = slidesList.length.toString();

				renderFilmstrip();
				goToSlide(0);

			} catch (e) {
				console.error(e);
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		// Render Left Filmstrip Thumbnails
		function renderFilmstrip() {
			if (!filmstripContainer) return;
			filmstripContainer.innerHTML = '';

			slidesList.forEach((s: any, idx: number) => {
				const thumb = document.createElement('div');
				thumb.className = `filmstrip-thumb p-2.5 rounded-xl border transition-all cursor-pointer select-none space-y-1.5 ${
					idx === currentSlideIndex
						? 'border-primary ring-2 ring-primary/40 bg-base-200/90 shadow-sm'
						: 'border-base-300 bg-base-200/40 hover:bg-base-200 hover:border-base-content/30'
				}`;
				thumb.setAttribute('data-index', idx.toString());

				thumb.innerHTML = `
					<div class="flex items-center justify-between text-[10px]">
						<span class="badge badge-xs ${idx === currentSlideIndex ? 'badge-primary font-bold' : 'badge-neutral'}">
							0${idx + 1}
						</span>
						<span class="font-mono text-base-content/60 truncate max-w-[120px] uppercase">
							${s.tag || `Slide ${idx + 1}`}
						</span>
					</div>
					<div class="text-xs font-bold text-base-content truncate">
						${s.title}
					</div>
					<div class="text-[9px] font-mono text-success flex items-center gap-1 truncate pt-0.5">
						<span>🔗</span>
						<span class="truncate">${s.source || 'Verified Source'}</span>
					</div>
				`;

				thumb.addEventListener('click', () => {
					goToSlide(idx);
				});

				filmstripContainer.appendChild(thumb);
			});
		}

		// Update Active Slide Display
		function goToSlide(index: number) {
			if (index < 0 || index >= slidesList.length) return;
			currentSlideIndex = index;
			const slide = slidesList[index];

			// Update stage content
			if (currentSlideTag) currentSlideTag.textContent = slide.tag || `SLIDE 0${index + 1}`;
			if (currentSlideIndexBadge) currentSlideIndexBadge.textContent = `SLIDE 0${index + 1}`;
			const sourceText = document.getElementById('current-slide-source-text');
			if (sourceText) sourceText.textContent = slide.source || 'Verified Source';
			if (currentSlideTitle) currentSlideTitle.textContent = slide.title;
			if (currentSlideSubtitle) currentSlideSubtitle.textContent = slide.subtitle || '';

			// Bullets
			if (currentSlideBullets) {
				const bullets = slide.bullets || [];
				currentSlideBullets.innerHTML = bullets
					.map(
						(b: string) => `
						<div class="flex items-start gap-2.5 p-2 sm:p-2.5 rounded-xl bg-base-200/60 border border-base-300/70 text-xs sm:text-sm font-medium text-base-content/90">
							<span class="text-primary font-bold shrink-0 mt-0.5">✓</span>
							<span class="leading-relaxed">${b}</span>
						</div>
					`
					)
					.join('');
			}

			// Footer
			const accountName = activeDeck.deal_context?.account_name || 'Enterprise Partnership';
			if (currentSlideFooterAccount) currentSlideFooterAccount.textContent = accountName;
			if (currentSlideFooterPage) currentSlideFooterPage.textContent = `Slide ${index + 1} of ${slidesList.length}`;

			// Indicator
			if (slidePosIndicator) slidePosIndicator.textContent = `${index + 1} / ${slidesList.length}`;

			// Speaker Notes
			if (currentSpeakerNotes) {
				currentSpeakerNotes.textContent = slide.speaker_note || 'Present key takeaway with confident operational delivery.';
			}

			// Update Filmstrip Selection
			const thumbs = document.querySelectorAll('.filmstrip-thumb');
			thumbs.forEach((t, i) => {
				if (i === index) {
					t.className = 'filmstrip-thumb p-2.5 rounded-xl border transition-all cursor-pointer select-none space-y-1.5 border-primary ring-2 ring-primary/40 bg-base-200/90 shadow-sm';
					t.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
				} else {
					t.className = 'filmstrip-thumb p-2.5 rounded-xl border transition-all cursor-pointer select-none space-y-1.5 border-base-300 bg-base-200/40 hover:bg-base-200 hover:border-base-content/30';
				}
			});
		}

		// Button listeners
		btnPrev?.addEventListener('click', () => goToSlide(currentSlideIndex - 1));
		btnNext?.addEventListener('click', () => goToSlide(currentSlideIndex + 1));

		// Keyboard Navigation
		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
				goToSlide(currentSlideIndex - 1);
			} else if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
				goToSlide(currentSlideIndex + 1);
			} else if (e.key === 'f' || e.key === 'F') {
				toggleFullscreen();
			}
		});

		// Fullscreen toggle
		function toggleFullscreen() {
			if (!slideStage) return;
			if (!document.fullscreenElement) {
				slideStage.requestFullscreen().catch((err) => console.warn(err));
			} else {
				document.exitFullscreen().catch((err) => console.warn(err));
			}
		}

		btnFullscreen?.addEventListener('click', toggleFullscreen);

		// Toggle Speaker Notes
		toggleNotesBar?.addEventListener('click', () => {
			notesOpen = !notesOpen;
			if (currentSpeakerNotes) currentSpeakerNotes.classList.toggle('hidden', !notesOpen);
			if (notesChevron) notesChevron.textContent = notesOpen ? '▼' : '▲';
		});

		// DOWNLOAD REAL STANDALONE PPT PRESENTATION DECK
		btnDownload?.addEventListener('click', () => {
			if (!slidesList.length) return;
			const accountName = activeDeck.deal_context?.account_name || 'Enterprise';
			const deckTitle = activeDeck.title || `${accountName} Presentation Deck`;

			const htmlDoc = `<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<title>${deckTitle}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<style>
		body { margin:0; padding:0; background:#0f172a; color:#f8fafc; font-family:system-ui,-apple-system,sans-serif; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100vh; }
		.deck-container { width:90vw; max-width:1200px; aspect-ratio:16/9; background:#1e293b; border-radius:16px; border:2px solid #334155; padding:48px; box-sizing:border-box; display:flex; flex-direction:column; justify-content:space-between; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5); }
		.header { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #334155; padding-bottom:16px; }
		.tag { background:#3b82f6; color:#fff; font-size:12px; font-weight:700; padding:4px 10px; border-radius:999px; text-transform:uppercase; }
		.confidential { font-size:11px; color:#94a3b8; font-family:monospace; }
		.title { font-size:36px; font-weight:800; margin:16px 0 8px 0; }
		.subtitle { font-size:16px; color:#94a3b8; margin-bottom:24px; }
		.bullet { display:flex; align-items:center; gap:12px; background:#0f172a; border:1px solid #334155; padding:14px 18px; border-radius:12px; margin-bottom:10px; font-size:15px; }
		.check { color:#10b981; font-weight:bold; }
		.footer { display:flex; justify-content:space-between; border-top:1px solid #334155; padding-top:14px; font-size:12px; color:#64748b; font-family:monospace; }
		.controls { margin-top:20px; display:flex; gap:12px; align-items:center; }
		button { background:#334155; color:#fff; border:none; padding:8px 16px; border-radius:8px; font-weight:600; cursor:pointer; }
		button:hover { background:#475569; }
		@media print { .controls { display:none; } .deck-container { width:100%; aspect-ratio:16/9; page-break-after:always; } }
	</style>
</head>
<body>
	<div class="deck-container" id="presentation-stage">
		<div class="header">
			<span class="tag" id="slide-tag"></span>
			<span class="confidential">CONFIDENTIAL • BUST REVENUE ENGINE</span>
		</div>
		<div>
			<h1 class="title" id="slide-title"></h1>
			<p class="subtitle" id="slide-sub"></p>
			<div id="slide-bullets"></div>
		</div>
		<div class="footer">
			<span>${accountName}</span>
			<span id="slide-num"></span>
		</div>
	</div>

	<div class="controls">
		<button onclick="prev()">◀ Previous</button>
		<span id="pos-label" style="font-family:monospace; font-weight:bold;"></span>
		<button onclick="next()">Next ▶</button>
		<button onclick="window.print()">🖨️ Print to PDF</button>
	</div>

	<script>
		const slides = ${JSON.stringify(slidesList)};
		let cur = 0;
		function render(i) {
			if (i < 0 || i >= slides.length) return;
			cur = i;
			const s = slides[i];
			document.getElementById('slide-tag').textContent = s.tag || 'Slide ' + (i+1);
			document.getElementById('slide-title').textContent = s.title;
			document.getElementById('slide-sub').textContent = s.subtitle || '';
			document.getElementById('slide-bullets').innerHTML = (s.bullets || []).map(b => '<div class="bullet"><span class="check">✓</span><span>' + b + '</span></div>').join('');
			document.getElementById('slide-num').textContent = 'Slide ' + (i+1) + ' of ' + slides.length;
			document.getElementById('pos-label').textContent = (i+1) + ' / ' + slides.length;
		}
		function prev() { render(cur - 1); }
		function next() { render(cur + 1); }
		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') prev();
			if (e.key === 'ArrowRight' || e.key === ' ') next();
		});
		render(0);
	<\/script>
</body>
</html>`;

			const blob = new Blob([htmlDoc], { type: 'text/html' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `${accountName.replace(/\s+/g, '_')}_Presentation_Deck.html`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		});

		// Initialize
		loadPresentation();
	</script>
</Layout>
