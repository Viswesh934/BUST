---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BUST — One Instruction. Multiple Sales Deliverables." description="Enterprise Sales Planning & Deal Execution Workspace">
	<div class="space-y-12 w-full pb-12">
		
		<!-- HERO SECTION -->
		<section class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-base-200/90 to-base-100 border-2 border-base-300 p-8 md:p-14 text-center space-y-6 shadow-md">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-base-100 border border-base-300 text-xs font-bold text-base-content shadow-2xs">
				<span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
				AI Sales Planning & Deal Execution Workspace
			</div>

			<div class="max-w-3xl mx-auto space-y-4">
				<h1 class="text-3xl md:text-5xl font-black tracking-tight text-base-content leading-tight">
					One Instruction.<br />
					<span class="text-primary underline decoration-primary/40 underline-offset-8">Multiple Sales Deliverables.</span>
				</h1>
				<p class="text-sm md:text-base text-base-content/85 max-w-2xl mx-auto leading-relaxed font-medium">
					Turn raw meeting discovery notes or account transcripts into Objection Battlecards, Mutual Action Plans, Executive Emails, and 16:9 Pitch Decks with a single prompt.
				</p>
			</div>

			<!-- Hero Action Buttons -->
			<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
				<a href="/" class="btn btn-neutral font-bold text-sm px-6 shadow-md gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
					Enter Deal Studio
				</a>
				<a href="/deals" class="btn btn-outline font-semibold text-sm px-6 gap-2">
					<span>🏨</span>
					Explore Hotel Deal Suites
				</a>
			</div>

			<!-- Core Proof Metrics -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto pt-8 border-t border-base-300/80 text-xs">
				<div class="p-3.5 rounded-xl bg-base-100 border border-base-300 shadow-2xs">
					<div class="text-2xl font-black text-base-content">40%</div>
					<div class="font-bold text-base-content/80 mt-0.5">Shorter Closing Cycle</div>
				</div>
				<div class="p-3.5 rounded-xl bg-base-100 border border-base-300 shadow-2xs">
					<div class="text-2xl font-black text-success">&lt; 60 Days</div>
					<div class="font-bold text-base-content/80 mt-0.5">Verified Payback</div>
				</div>
				<div class="p-3.5 rounded-xl bg-base-100 border border-base-300 shadow-2xs">
					<div class="text-2xl font-black text-base-content">8+ Hours</div>
					<div class="font-bold text-base-content/80 mt-0.5">Saved per AE / Week</div>
				</div>
				<div class="p-3.5 rounded-xl bg-base-100 border border-base-300 shadow-2xs">
					<div class="text-2xl font-black text-primary">100%</div>
					<div class="font-bold text-base-content/80 mt-0.5">Deterministic Output</div>
				</div>
			</div>
		</section>

		<!-- LIVE NATURAL LANGUAGE DEAL DISCOVERY INTAKE (Strictly on Landing Page) -->
		<section class="card bg-base-200 border-2 border-base-300 shadow-md p-6 md:p-8 space-y-4">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-base-300 pb-3">
				<div>
					<h2 class="text-sm font-bold text-base-content uppercase tracking-wider flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></span>
						Live Deal Discovery Intake Demo
					</h2>
					<p class="text-xs text-base-content/80 mt-0.5 font-medium">
						Experience one-instruction execution: paste meeting notes to generate battlecards, roadmap, email, and deck.
					</p>
				</div>
				<span class="badge badge-sm badge-neutral font-semibold">One Instruction → 4 Deliverables</span>
			</div>

			<div>
				<textarea
					id="landing-prompt-input"
					rows="3"
					class="textarea textarea-bordered w-full bg-base-100 text-xs text-base-content leading-relaxed font-sans font-medium border-2 border-base-300 focus:border-primary focus:outline-none rounded-xl"
				>We just completed technical discovery with ACME Corp for a $150,000 ARR deal replacing LegacyVendor. Generate competitive objection battlecards for pricing and SOC2 security, a 6-step Mutual Action Plan roadmap, and an executive proposal email to Sarah (VP of Sales Ops).</textarea>
			</div>

			<div class="flex items-center justify-between pt-1">
				<span id="landing-gen-status" class="text-xs text-base-content/70 font-medium">
					Ready to test live generation
				</span>
				<a href="/" class="btn btn-sm btn-neutral font-bold gap-2 shadow-sm">
					<span>Launch in Command Director →</span>
				</a>
			</div>
		</section>

		<!-- INTERACTIVE SHOWCASE SECTION -->
		<section class="space-y-6">
			<div class="text-center space-y-2 max-w-xl mx-auto">
				<h2 class="text-2xl font-bold tracking-tight text-base-content">
					Designed for Serious Revenue Teams
				</h2>
				<p class="text-xs text-base-content/75 font-medium">
					Every module is built with high tactile fidelity — from physical stacked cards to industrial pipelines.
				</p>
			</div>

			<!-- Interactive Feature Selector Tabs -->
			<div class="flex items-center justify-center gap-2 overflow-x-auto pb-2 text-xs">
				<button class="showcase-tab btn btn-sm btn-neutral" data-tab="cards">
					🎴 Stacked 3D Battlecards
				</button>
				<button class="showcase-tab btn btn-sm btn-ghost text-base-content/75" data-tab="pipeline">
					⚙️ Industrial DAG Pipeline
				</button>
				<button class="showcase-tab btn btn-sm btn-ghost text-base-content/75" data-tab="suites">
					🏨 Hotel Deal Suites
				</button>
				<button class="showcase-tab btn btn-sm btn-ghost text-base-content/75" data-tab="ppt">
					📽️ 16:9 PPT Slide Deck
				</button>
			</div>

			<!-- Showcase Panels -->
			<div class="card bg-base-100 border-2 border-base-300 shadow-md p-6 md:p-8">
				
				<!-- TAB 1: BATTLECARDS PREVIEW -->
				<div id="showcase-cards" class="showcase-content space-y-5">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-base-200 pb-4">
						<div>
							<h3 class="font-bold text-base text-base-content">Physical Stacked Objection Deck</h3>
							<p class="text-xs text-base-content/75">Flip to reveal winning responses and cycle the deck like real cards.</p>
						</div>
						<a href="/battlecards" class="btn btn-xs btn-outline self-start md:self-auto">Launch Battlecards Deck →</a>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
						<div class="p-5 rounded-xl bg-base-200 border-2 border-base-300 space-y-2">
							<span class="badge badge-xs badge-neutral">Objection Front</span>
							<div class="font-bold text-sm text-base-content">"Your price is 20% higher than LegacyVendor renewal."</div>
							<p class="text-[11px] text-base-content/70">VP Sales Ops objection on pricing and budget constraints.</p>
						</div>
						<div class="p-5 rounded-xl bg-base-200 border-2 border-primary/30 space-y-2">
							<span class="badge badge-xs badge-success">Winning Response Back</span>
							<div class="font-bold text-sm text-base-content">Pivot to TCO & $80k Net Savings</div>
							<p class="text-[11px] text-base-content/70">Eliminates 2 FTEs spent manually curating data. 60-day break-even.</p>
						</div>
					</div>
				</div>

				<!-- TAB 2: PIPELINE PREVIEW -->
				<div id="showcase-pipeline" class="showcase-content hidden space-y-5">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-base-200 pb-4">
						<div>
							<h3 class="font-bold text-base text-base-content">Autonomous Industrial Pipeline</h3>
							<p class="text-xs text-base-content/75">Parallel execution conduits with manifold distribution and telemetry.</p>
						</div>
						<a href="/agent" class="btn btn-xs btn-outline self-start md:self-auto">View Live Conduits →</a>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
						<div class="p-4 rounded-xl bg-base-200 border border-base-300 space-y-1">
							<div class="font-bold text-base-content">🚰 Intake Valve</div>
							<p class="text-[11px] text-base-content/70">Parses deal facts & account constraints.</p>
						</div>
						<div class="p-4 rounded-xl bg-base-200 border border-base-300 space-y-1">
							<div class="font-bold text-base-content">⚙️ 3-Way Manifold</div>
							<p class="text-[11px] text-base-content/70">Runs battlecards, MAPs, & financials concurrently.</p>
						</div>
						<div class="p-4 rounded-xl bg-base-200 border border-base-300 space-y-1">
							<div class="font-bold text-base-content">⚡ Convergence Refinery</div>
							<p class="text-[11px] text-base-content/70">Distills verified outputs into email and slides.</p>
						</div>
					</div>
				</div>

				<!-- TAB 3: HOTEL SUITES PREVIEW -->
				<div id="showcase-suites" class="showcase-content hidden space-y-5">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-base-200 pb-4">
						<div>
							<h3 class="font-bold text-base text-base-content">Hotel Deal Suites & Digital Keycards</h3>
							<p class="text-xs text-base-content/75">Private suites with encrypted keycard links for buyer board members.</p>
						</div>
						<a href="/deals" class="btn btn-xs btn-outline self-start md:self-auto">Open Hotel Suites →</a>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
						<div class="p-5 rounded-xl bg-base-200 border border-base-300 space-y-2">
							<div class="flex justify-between items-center">
								<span class="font-bold text-sm text-base-content">Suite 1001 • ACME Corp ($150k ARR)</span>
								<span class="badge badge-xs badge-success">Occupied</span>
							</div>
							<p class="text-[11px] text-base-content/70">Digital Keycard #ACME-8F2 • 4 In-Room Deliverables</p>
						</div>
						<div class="p-5 rounded-xl bg-base-200 border border-base-300 space-y-2">
							<div class="flex justify-between items-center">
								<span class="font-bold text-sm text-base-content">Suite 402 • Delta Logistics ($220k ARR)</span>
								<span class="badge badge-xs badge-neutral">Turn-Down Service</span>
							</div>
							<p class="text-[11px] text-base-content/70">Digital Keycard #DELTA-4B9 • In-Room Draft Review</p>
						</div>
					</div>
				</div>

				<!-- TAB 4: PPT SLIDER PREVIEW -->
				<div id="showcase-ppt" class="showcase-content hidden space-y-5">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-base-200 pb-4">
						<div>
							<h3 class="font-bold text-base text-base-content">Executive 16:9 Presentation Deck</h3>
							<p class="text-xs text-base-content/75">PowerPoint slider with speaker notes, side arrows, and .PPTX export.</p>
						</div>
						<a href="/presentations" class="btn btn-xs btn-outline self-start md:self-auto">Launch Presentation →</a>
					</div>
					<div class="p-6 rounded-xl bg-base-200 border border-base-300 text-center space-y-2">
						<div class="text-lg font-extrabold text-base-content">Accelerating Enterprise Deal Velocity</div>
						<p class="text-xs text-base-content/75 max-w-lg mx-auto">
							Slide 1 of 4 • Includes speaker talking points, financial ROI break-even, and commercial milestones.
						</p>
					</div>
				</div>

			</div>
		</section>

		<!-- CALL TO ACTION FOOTER -->
		<section class="card bg-base-200 border-2 border-base-300 p-8 text-center space-y-4 rounded-3xl shadow-sm">
			<h2 class="text-2xl font-bold text-base-content">Ready to Plan Your Next Deal?</h2>
			<p class="text-xs text-base-content/80 max-w-md mx-auto font-medium">
				Enter raw discovery notes and experience instant multi-artifact generation.
			</p>
			<div>
				<a href="/" class="btn btn-neutral font-bold text-sm px-6">
					Launch Deal Studio Workspace →
				</a>
			</div>
		</section>

	</div>

	<script>
		const tabs = document.querySelectorAll('.showcase-tab');
		const contents = {
			cards: document.getElementById('showcase-cards'),
			pipeline: document.getElementById('showcase-pipeline'),
			suites: document.getElementById('showcase-suites'),
			ppt: document.getElementById('showcase-ppt'),
		};

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const key = tab.getAttribute('data-tab') as 'cards' | 'pipeline' | 'suites' | 'ppt';
				
				tabs.forEach((t) => {
					t.classList.remove('btn-neutral');
					t.classList.add('btn-ghost', 'text-base-content/75');
				});
				tab.classList.add('btn-neutral');
				tab.classList.remove('btn-ghost', 'text-base-content/75');

				Object.values(contents).forEach((c) => c?.classList.add('hidden'));
				contents[key]?.classList.remove('hidden');
			});
		});
	</script>
</Layout>
