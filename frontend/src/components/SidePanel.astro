---
// SidePanel.astro: Floating Slide-Over Deliverables Inspector
---

<div
	id="side-panel"
	class="absolute top-0 right-13 bottom-0 w-[520px] md:w-[580px] xl:w-[640px] max-w-[calc(100vw-4.5rem)] z-40 bg-base-100/98 backdrop-blur-xl border-l border-base-300 shadow-2xl flex flex-col rounded-l-2xl transition-all duration-300 ease-out transform translate-x-[110%] opacity-0 pointer-events-none"
>
	<!-- STICKY SIDE PANEL HEADER -->
	<div class="sticky top-0 z-30 bg-base-100/95 backdrop-blur-md flex items-center justify-between p-3.5 border-b border-base-200 gap-2 shrink-0">
		<div class="flex items-center gap-2 min-w-0">
			<span class="text-sm font-bold text-base-content truncate" id="side-panel-title">🎴 Objection Battlecards</span>
			<span class="badge badge-xs badge-neutral font-mono shrink-0" id="side-active-account">Active</span>
		</div>
		
		<div class="flex items-center gap-2 shrink-0">
			<!-- Prominent "Open Full View ↗" Redirect Link -->
			<a id="btn-open-full-page" href="/battlecards" class="btn btn-xs btn-neutral gap-1 font-semibold">
				<span id="full-page-btn-text">Open Full Deck ↗</span>
			</a>
			<button id="btn-close-side" type="button" class="btn btn-xs btn-circle btn-ghost text-base-content/70 hover:text-base-content cursor-pointer" title="Close Side Panel">
				✕
			</button>
		</div>
	</div>

	<!-- SIDE CONTENT VIEWPORT (Scrollable) -->
	<div class="flex-1 overflow-y-auto p-4 space-y-4" id="side-content-area">
		<!-- Empty Placeholder -->
		<div id="side-empty-state" class="py-16 text-center space-y-3">
			<div class="w-12 h-12 rounded-2xl bg-base-200 border border-base-300 mx-auto flex items-center justify-center text-2xl shadow-xs">
				📑
			</div>
			<div class="space-y-1">
				<h4 class="font-bold text-sm text-base-content" id="side-empty-title">Select an App Icon</h4>
				<p class="text-xs text-base-content/70 max-w-xs mx-auto leading-relaxed" id="side-empty-desc">
					Click any app icon on the side dock to inspect generated battlecards, slide decks, proposals, or action plans.
				</p>
			</div>
		</div>

		<!-- Dynamic Content Container -->
		<div id="side-deliverable-view" class="hidden space-y-4 min-w-0 break-words">
			<!-- Injected via deliverable modules -->
		</div>
	</div>
</div>
